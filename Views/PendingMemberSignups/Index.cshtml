@model IEnumerable<WebApplication1.Models.PendingMemberSignup>
@using WebApplication1.Models
@{
    ViewData["Title"] = "Verifikasi Member";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Pending Paid Signups</h4>
        <small class="text-muted">Member yang sudah bayar dan menunggu verifikasi kasir/admin.</small>
    </div>
</div>

@if (!Model.Any())
{
    <div class="op-card text-center py-5">
        <i class="bi bi-check2-circle" style="font-size:2.5rem;color:var(--op-muted);"></i>
        <p class="mt-3 mb-0" style="color:var(--op-muted);">Tidak ada pendaftaran member yang menunggu verifikasi.</p>
    </div>
}
else
{
    <div class="op-card">
        <table class="op-table">
            <thead>
                <tr>
                    <th>Kode</th>
                    <th>Nama</th>
                    <th>Username</th>
                    <th>Telepon</th>
                    <th>Status</th>
                    <th>Bayar</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var signup in Model)
                {
                    var badgeColor = "#f59e0b";
                    <tr>
                        <td><code style="color:#f59e0b;">@signup.SignupCode</code></td>
                        <td class="fw-semibold">@signup.FullName</td>
                        <td>@signup.Username</td>
                        <td>@signup.PhoneNumber</td>
                        <td>
                            <span class="op-badge-status" style="background:@(badgeColor)22;color:@badgeColor;border:1px solid @(badgeColor)55;">
                                Menunggu verifikasi
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold">Rp @signup.Amount.ToString("N0")</div>
                            <small class="text-muted">@BusinessTime.ToBusinessTime(signup.PaidAtUtc ?? signup.CreatedAtUtc).ToString("dd MMM yyyy HH:mm")</small>
                        </td>
                        <td>
                            <form asp-action="Verify" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@signup.Id" />
                                <button type="submit" class="op-btn op-btn-success" data-confirm-title="Verifikasi Member" data-confirm-message="Verifikasi member ini sekarang?">
                                    <i class="bi bi-person-check"></i> Verifikasi
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
