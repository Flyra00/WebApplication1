@model WebApplication1.ViewModels.Admin.AdminChargesSettingsViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Pengaturan Persentase";
}

<div class="card p-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1">Pengaturan Persentase</h3>
        <p class="text-muted mb-0">Atur PPN, service, dan DP reservasi dari database.</p>
    </div>

    <form asp-action="Index" method="post" class="row g-3">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div class="col-md-4">
            <label asp-for="OrderPpnPercentage" class="form-label"></label>
            <input asp-for="OrderPpnPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
            <span asp-validation-for="OrderPpnPercentage" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="OrderServicePercentage" class="form-label"></label>
            <input asp-for="OrderServicePercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
            <span asp-validation-for="OrderServicePercentage" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="ReservationDpPercentage" class="form-label"></label>
            <input asp-for="ReservationDpPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
            <span asp-validation-for="ReservationDpPercentage" class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
        </div>
    </form>
</div>
