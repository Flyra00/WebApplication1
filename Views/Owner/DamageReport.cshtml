@model IEnumerable<WebApplication1.Models.DamageReport>
@{
    ViewData["Title"] = "Laporan Kerusakan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="ow-card">
    <h6 class="fw-semibold mb-3"><i class="bi bi-shield-exclamation me-2" style="color:#ef4444;"></i>Histori Laporan Kerusakan Barang</h6>
    @if (!Model.Any())
    {
        <p style="color:var(--owner-muted);">Belum ada laporan kerusakan.</p>
    }
    else
    {
        <table class="ow-table">
            <thead>
                <tr>
                    <th>Tanggal</th>
                    <th>Barang</th>
                    <th>Kategori</th>
                    <th class="text-end">Qty</th>
                    <th>Dilaporkan oleh</th>
                    <th>Keterangan</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var sc = d.Status switch { "Reported" => "#ef4444", "Reviewed" => "#f97316", "Resolved" => "#22c55e", _ => "#64748b" };
                    <tr>
                        <td style="font-size:.8rem;color:var(--owner-muted);">@BusinessTime.ToBusinessTime(d.ReportDate).ToString("dd/MM/yy HH:mm")</td>
                        <td class="fw-semibold">@d.InventoryItem?.ItemName</td>
                        <td style="font-size:.8rem;color:var(--owner-muted);">@d.InventoryItem?.Category</td>
                        <td class="text-end" style="color:#ef4444;font-weight:600;">@d.Qty</td>
                        <td style="font-size:.85rem;">@(d.ReportedByUser?.FullName ?? d.ReportedByUser?.UserName)</td>
                        <td style="font-size:.8rem;color:var(--owner-muted);max-width:200px;">@(d.Description?.Length > 50 ? d.Description[..50] + "…" : d.Description)</td>
                        <td><span class="badge" style="background:@(sc)22;color:@sc;border:1px solid @(sc)44;font-size:.7rem;">@d.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
