@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model List<Product>
@{
    Layout = null;
    var culture = new CultureInfo("id-ID");
    var activeTables = ViewBag.ActiveTables as List<Table> ?? new List<Table>();
    var products = Model ?? new List<Product>();
    var categories = products
        .Select(product => product.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList();
    var tableNumber = Context.Request.Cookies["nr_tableNumber"] ?? "--";
    var tableToken = Context.Request.Cookies["nr_tableToken"] ?? string.Empty;
    var featuredProduct = products.FirstOrDefault();
    var dashboardUrl = (User?.IsInRole(AppRoles.Admin) ?? false) ? "/Admin"
        : (User?.IsInRole(AppRoles.Supervisor) ?? false) ? "/Supervisor"
        : (User?.IsInRole(AppRoles.Kasir) ?? false) ? "/Cashier"
        : (User?.IsInRole(AppRoles.Kitchen) ?? false) ? "/Kitchen"
        : (User?.IsInRole(AppRoles.Owner) ?? false) ? "/Owner/Dashboard"
        : (User?.IsInRole(AppRoles.Customer) ?? false) ? "/Member/Profile"
        : null;
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isCustomer = User?.IsInRole(AppRoles.Customer) ?? false;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <meta name="table-token" content="@tableToken" />
    <title>Menu - Nusantara Heritage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Serif:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        :root {
            --surface: #fcf9f8;
            --surface-lowest: #ffffff;
            --surface-low: #f6f3f2;
            --surface-container: #f0eded;
            --surface-high: #eae7e7;
            --surface-highest: #e5e2e1;
            --warm-beige: #f4ede3;
            --on-surface: #1c1b1b;
            --on-surface-variant: #584238;
            --outline: #8c7166;
            --outline-variant: #e0c0b2;
            --terracotta: #9c3f00;
            --terracotta-dark: #7a3000;
            --terracotta-soft: #c45100;
            --forest: #5e604d;
            --inverse-surface: #313030;
            --soft-black: #2c2c2c;
            --error: #ba1a1a;
            --shadow: 0 20px 60px rgba(44, 44, 44, .08);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            min-height: 100dvh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(224, 122, 95, .14), transparent 32rem),
                linear-gradient(180deg, #fff8f2 0%, var(--surface) 36%, #fbf6f2 100%);
            color: var(--on-surface);
            font-family: 'Inter', sans-serif;
        }
        a { color: inherit; text-decoration: none; }
        button, input { font: inherit; }
        button { cursor: pointer; border: 0; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .page-shell { width: min(100% - 48px, 1180px); margin: 0 auto; }

        .site-header {
            position: sticky;
            top: 0;
            z-index: 30;
            border-bottom: 1px solid rgba(219, 193, 186, .65);
            background: rgba(244, 237, 227, .88);
            backdrop-filter: blur(16px);
        }
        .site-nav {
            min-height: 82px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }
        .brand { display: inline-flex; align-items: center; gap: 14px; min-width: 0; }
        .brand-mark {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--surface-lowest);
            color: var(--terracotta);
            box-shadow: inset 0 0 0 1px rgba(219, 193, 186, .52);
        }
        .brand-text { display: grid; gap: 2px; }
        .brand-name {
            color: var(--terracotta-dark);
            font-family: 'Noto Serif', serif;
            font-size: 22px;
            font-weight: 700;
            line-height: 1;
        }
        .brand-subtitle { color: var(--on-surface-variant); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
        .nav-links { display: flex; align-items: center; gap: 24px; color: var(--on-surface-variant); font-weight: 600; }
        .nav-links a:hover { color: var(--terracotta-dark); }
        .nav-actions { display: flex; align-items: center; gap: 12px; }
        .table-pill, .outline-link, .primary-link {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 999px;
            padding: 0 18px;
            font-weight: 700;
        }
        .table-pill { background: var(--surface-lowest); color: var(--terracotta); border: 1px solid var(--outline-variant); }
        .outline-link { background: transparent; color: var(--forest); border: 1px solid rgba(72, 102, 72, .45); }
        .primary-link { background: var(--terracotta); color: #fff; }
        .cart-trigger {
            position: relative;
            width: 44px;
            height: 44px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            color: var(--terracotta);
            background: var(--surface-lowest);
            border: 1px solid var(--outline-variant);
        }
        .cart-trigger-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            background: var(--terracotta);
            color: #fff;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
            font-size: 11px;
            font-weight: 700;
        }
        .cart-trigger-badge.visible { display: inline-flex; }

        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(320px, .75fr);
            gap: 56px;
            align-items: center;
            padding: 72px 0 58px;
        }
        .eyebrow {
            margin: 0 0 14px;
            color: var(--forest);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
        }
        .hero-title {
            max-width: 780px;
            margin: 0;
            color: var(--on-surface);
            font-family: 'Noto Serif', serif;
            font-size: clamp(44px, 6vw, 76px);
            font-weight: 700;
            line-height: .98;
            letter-spacing: -.045em;
        }
        .hero-copy {
            max-width: 640px;
            margin: 24px 0 0;
            color: var(--on-surface-variant);
            font-size: 18px;
            line-height: 1.75;
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
        .hero-button {
            min-height: 54px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border-radius: 12px;
            padding: 0 22px;
            font-weight: 800;
        }
        .hero-button.primary { background: var(--terracotta); color: #fff; }
        .hero-button.secondary { background: var(--surface-lowest); color: var(--forest); border: 1px solid rgba(72, 102, 72, .42); }
        .feature-card {
            overflow: hidden;
            border-radius: 30px;
            background: var(--surface-lowest);
            border: 1px solid rgba(219, 193, 186, .72);
            box-shadow: var(--shadow);
        }
        .feature-image { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; display: block; background: var(--surface-container); }
        .feature-body { padding: 24px; }
        .feature-label { color: var(--forest); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .feature-title { margin: 8px 0 10px; font-family: 'Noto Serif', serif; font-size: 30px; line-height: 1.15; }
        .feature-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--terracotta); font-family: 'Noto Serif', serif; font-size: 22px; }

        .toolbar {
            display: grid;
            grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
            gap: 20px;
            align-items: center;
            margin-bottom: 30px;
        }
        .search-box {
            min-height: 58px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 999px;
            background: var(--surface-highest);
            color: var(--on-surface-variant);
            padding: 0 20px;
        }
        .search-box input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            background: transparent;
            color: var(--on-surface);
            font-size: 17px;
        }
        .category-strip { display: flex; gap: 12px; overflow-x: auto; padding: 4px 0; scrollbar-width: none; }
        .category-strip::-webkit-scrollbar { display: none; }
        .category-chip {
            flex: 0 0 auto;
            min-height: 48px;
            border-radius: 999px;
            padding: 0 20px;
            border: 1px solid var(--terracotta);
            background: var(--surface);
            color: var(--on-surface);
            font-weight: 700;
            white-space: nowrap;
            transition: transform .18s ease, background .18s ease, color .18s ease;
        }
        .category-chip.active { border-color: transparent; background: var(--inverse-surface); color: #fff; transform: translateY(-1px); }

        .menu-section { padding: 26px 0 88px; }
        .section-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 22px; }
        .section-heading h2 { margin: 0; font-family: 'Noto Serif', serif; font-size: clamp(32px, 4vw, 48px); line-height: 1; }
        .section-heading p { max-width: 420px; margin: 0; color: var(--on-surface-variant); line-height: 1.65; }
        .menu-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 30px; align-items: start; }
        .menu-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
        .menu-card {
            display: flex;
            min-width: 0;
            overflow: hidden;
            flex-direction: column;
            border-radius: 22px;
            background: var(--surface-lowest);
            border: 1px solid rgba(219, 193, 186, .78);
            box-shadow: 0 8px 28px rgba(44, 44, 44, .055);
            transition: transform .18s ease, box-shadow .18s ease;
        }
        .menu-card:hover { transform: translateY(-3px); box-shadow: 0 18px 42px rgba(44, 44, 44, .09); }
        .menu-image-wrap { position: relative; aspect-ratio: 4 / 3; width: 100%; overflow: hidden; background: var(--surface-container); }
        .menu-image { width: 100%; height: 100%; object-fit: cover; display: block; }
        .menu-open {
            position: absolute;
            inset: 0;
            background: transparent;
            border: 0;
            color: transparent;
            z-index: 1;
        }
        .fab-add {
            position: absolute;
            right: 16px;
            bottom: 0;
            transform: translateY(50%);
            width: 52px;
            height: 52px;
            border-radius: 999px;
            border: 0;
            background: var(--terracotta);
            color: #fff;
            display: grid;
            place-items: center;
             box-shadow: 0 6px 20px rgba(156, 63, 0, .35);
            z-index: 3;
        }
        .fab-add .material-symbols-outlined { font-size: 24px; }
        .chef-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            border-radius: 999px;
            padding: 8px 11px;
             background: rgba(72, 102, 72, .94);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
        }
        .menu-body { display: flex; flex: 1; flex-direction: column; padding: 28px 20px 20px; }
        .menu-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
        .menu-title {
            min-height: 64px;
            margin: 0;
            border: 0;
            background: transparent;
            padding: 0;
            text-align: left;
            color: var(--on-surface);
            font-family: 'Noto Serif', serif;
            font-size: 24px;
            font-weight: 600;
            line-height: 1.12;
            letter-spacing: -.02em;
            cursor: pointer;
        }
        .menu-price-inline { color: var(--terracotta); font-family: 'Noto Serif', serif; font-size: 20px; font-weight: 700; white-space: nowrap; }
        .menu-detail { display: -webkit-box; min-height: 48px; margin: 0 0 18px; overflow: hidden; color: var(--on-surface-variant); line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
        .menu-meta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .menu-tag {
            display: inline-flex;
            align-items: center;
            min-height: 32px;
            border-radius: 999px;
            border: 1px solid var(--outline-variant);
            padding: 0 12px;
            color: var(--on-surface-variant);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }
        .add-button, .qty-button {
            min-height: 50px;
            border-radius: 10px;
            font-weight: 800;
            transition: transform .16s ease, background .16s ease, color .16s ease, border-color .16s ease;
        }
         .add-button { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--forest); background: transparent; color: var(--forest); }
         .add-button.primary { border-color: var(--terracotta); background: var(--terracotta-soft); color: #fff; }
        .add-button:active, .qty-button:active, .hero-button:active { transform: scale(.985); }
        .quantity-control { display: none; align-items: center; justify-content: space-between; gap: 10px; min-height: 50px; border-radius: 12px; background: var(--surface-container); padding: 5px; }
        .quantity-control.active { display: flex; }
         .qty-button { width: 42px; min-height: 40px; display: grid; place-items: center; background: var(--surface-lowest); color: var(--on-surface); box-shadow: 0 2px 8px rgba(44, 44, 44, .06); }
        .qty-value { min-width: 28px; text-align: center; font-weight: 700; }
        .is-in-cart .add-button { display: none; }
        .is-in-cart .quantity-control { display: flex; }

        .cart-panel h3 { margin: 0; font-family: 'Noto Serif', serif; font-size: 28px; }
        .cart-note { margin: 8px 0 18px; color: var(--on-surface-variant); line-height: 1.55; }
         .cart-item { display: flex; gap: 14px; padding: 15px 0; border-top: 1px solid rgba(219, 193, 186, .65); }
        .cart-item-main { flex: 1; min-width: 0; }
        .cart-item-title { margin: 0 0 5px; font-weight: 800; }
        .cart-item-price { color: var(--on-surface-variant); font-size: 14px; }
        .qty-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            background: var(--surface-container);
            padding: 4px 12px;
            color: var(--on-surface-variant);
            font-size: 13px;
            margin-top: 8px;
        }
        .cart-empty { padding: 20px 0; color: var(--on-surface-variant); }
        .cart-total { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--outline-variant); }
        .cart-total span { color: var(--on-surface-variant); }
        .cart-total strong { color: var(--terracotta); font-family: 'Noto Serif', serif; font-size: 26px; }
        .checkout-card {
            margin-top: 16px;
            border-radius: 16px;
             border: 1px solid rgba(224, 192, 178, .7);
            background: var(--surface-low);
            padding: 14px;
        }
        .checkout-card h4 {
            margin: 0 0 8px;
            font-family: 'Noto Serif', serif;
            font-size: 21px;
        }
        .checkout-note {
            width: 100%;
            min-height: 82px;
            border: 1px solid var(--outline);
            border-radius: 10px;
            resize: vertical;
            background: var(--surface-lowest);
            color: var(--on-surface);
            padding: 10px 12px;
        }
         .checkout-note:focus { outline: 2px solid rgba(156, 63, 0, .22); border-color: var(--terracotta); }
        .payment-option {
            width: 100%;
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            border: 1px solid var(--outline);
            background: var(--surface-lowest);
            color: var(--on-surface);
            padding: 0 12px;
            margin-top: 8px;
            text-align: left;
            font-weight: 700;
        }
        .payment-option.active {
            border-color: var(--terracotta);
             background: rgba(156, 63, 0, .08);
        }
        .payment-option:disabled {
            opacity: .6;
            cursor: not-allowed;
        }
        .submit-button, .secondary-button { width: 100%; min-height: 54px; border-radius: 12px; font-weight: 800; }
        .submit-button { margin-top: 18px; background: var(--terracotta); color: #fff; }
        .submit-button:disabled { opacity: .58; cursor: not-allowed; }
        .secondary-button { margin-top: 10px; background: var(--surface-container); color: var(--on-surface); }
        .feedback { min-height: 22px; margin-top: 12px; color: var(--on-surface-variant); font-size: 14px; line-height: 1.45; }
        .feedback.error { color: var(--error); }
         .feedback.success { color: var(--forest); }

        .cart-backdrop {
            position: fixed;
            inset: 0;
             background: rgba(49, 48, 48, .35);
            z-index: 71;
            display: none;
        }
        .cart-backdrop.open { display: block; }
        .cart-drawer {
            position: fixed;
            top: 0;
            right: -420px;
            width: min(100%, 390px);
            height: 100dvh;
            z-index: 72;
            background: var(--surface-lowest);
             border-left: 1px solid rgba(219, 193, 186, .78);
             box-shadow: -12px 0 36px rgba(44, 44, 44, .18);
            transition: right .28s ease;
            display: flex;
            flex-direction: column;
        }
        .cart-drawer.open { right: 0; }
        .cart-drawer-header {
            min-height: 72px;
            padding: 0 16px;
             border-bottom: 1px solid rgba(219, 193, 186, .7);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .cart-drawer-title { font-family: 'Noto Serif', serif; font-size: 28px; margin: 0; }
        .cart-drawer-close {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            background: var(--surface-low);
            color: var(--on-surface-variant);
        }
        .cart-drawer-body {
            flex: 1;
            overflow: auto;
            padding: 16px;
        }
        .no-scroll { overflow: hidden; }

        .empty-state { grid-column: 1 / -1; padding: 46px 24px; text-align: center; border-radius: 24px; background: var(--surface-lowest); border: 1px dashed var(--outline-variant); color: var(--on-surface-variant); }
        .empty-state h2 { margin: 0 0 8px; color: var(--on-surface); font-family: 'Noto Serif', serif; font-size: 28px; }
        .empty-state p { margin: 0; }

        .table-dialog {
            position: fixed;
            inset: 0;
            z-index: 70;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
             background: rgba(27, 28, 28, .42);
        }
        .table-dialog.open { display: flex; }
        .table-panel {
            width: min(100%, 460px);
            border-radius: 24px;
            background: var(--surface-lowest);
             box-shadow: 0 28px 70px rgba(44, 44, 44, .22);
            padding: 28px;
        }
        .table-panel h2 { margin: 0 0 8px; font-family: 'Noto Serif', serif; font-size: 32px; }
        .table-panel p { margin: 0 0 20px; color: var(--on-surface-variant); line-height: 1.6; }
        .table-input { width: 100%; min-height: 56px; border: 1px solid var(--outline-variant); border-radius: 12px; padding: 0 16px; color: var(--on-surface); background: var(--surface); outline-color: var(--terracotta); font-size: 18px; }
        .table-select { width: 100%; min-height: 56px; border: 1px solid var(--outline-variant); border-radius: 12px; padding: 0 16px; color: var(--on-surface); background: var(--surface-lowest); outline-color: var(--terracotta); font-size: 17px; }
         .table-select:focus { border-color: var(--terracotta); outline: 2px solid rgba(156, 63, 0, .15); }
        .table-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
        .table-action-button {
            width: 100%;
            min-height: 54px;
            border-radius: 12px;
            font-weight: 800;
            border: 1px solid var(--terracotta);
            box-sizing: border-box;
        }
        .table-action-button.guest {
            background: var(--terracotta-soft);
             color: #fff;
        }
        .table-action-button.member {
            background: var(--surface-lowest);
             color: var(--on-surface);
        }

        .auth-dialog {
            position: fixed;
            inset: 0;
            z-index: 73;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
             background: rgba(49, 48, 48, .4);
        }
        .auth-dialog.open { display: flex; }
        .auth-panel {
            width: min(100%, 460px);
            border-radius: 18px;
            background: var(--surface-lowest);
            border: 1px solid var(--outline-variant);
            padding: 22px;
             box-shadow: 0 22px 60px rgba(44, 44, 44, .24);
        }
        .auth-panel h3 { margin: 0; font-family: 'Noto Serif', serif; font-size: 30px; }
        .auth-panel p { margin: 8px 0 18px; color: var(--on-surface-variant); }
        .auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .auth-tab { min-height: 42px; border-radius: 999px; background: var(--surface-low); color: var(--on-surface-variant); font-weight: 700; }
         .auth-tab.active { background: var(--inverse-surface); color: #fff; }
        .auth-group { margin-bottom: 10px; }
        .auth-group label { display: block; margin-bottom: 5px; font-weight: 700; color: var(--on-surface); font-size: 14px; }
        .auth-input { width: 100%; min-height: 48px; border: 1px solid var(--outline-variant); border-radius: 10px; padding: 0 12px; background: var(--surface-lowest); color: var(--on-surface); }
        .auth-error { min-height: 20px; color: var(--error); font-size: 13px; margin-top: 8px; }

        .item-modal {
            position: fixed;
            inset: 0;
            z-index: 72;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
             background: rgba(49, 48, 48, .4);
            backdrop-filter: blur(2px);
        }
        .item-modal.open { display: flex; }
        .item-modal-panel {
            width: min(100%, 1120px);
            border-radius: 20px;
            background: var(--surface-lowest);
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(340px, 560px);
             box-shadow: 0 24px 80px rgba(44, 44, 44, .28);
            position: relative;
        }
        .item-modal-close {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 42px;
            height: 42px;
            border-radius: 999px;
             border: 1px solid rgba(0,0,0,.08);
             background: rgba(255,255,255,.82);
            display: grid;
            place-items: center;
            z-index: 2;
        }
        .item-modal-image {
            width: 100%;
            height: 100%;
            min-height: 430px;
            object-fit: cover;
            display: block;
            background: var(--surface-container);
        }
        .item-modal-content { padding: 28px 30px; }
        .item-modal-title { margin: 0 0 6px; font-family: 'Noto Serif', serif; font-size: clamp(34px, 3vw, 56px); line-height: 1.05; }
        .item-modal-category { color: var(--terracotta); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }
        .item-modal-desc { margin: 18px 0 22px; color: var(--on-surface-variant); line-height: 1.65; font-size: 17px; }
        .item-modal-foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; border-top: 1px solid var(--outline-variant); padding-top: 18px; }
        .item-modal-price { color: var(--on-surface); font-family: 'Noto Serif', serif; font-size: 44px; font-weight: 700; }
        .item-modal-add { width: 100%; margin-top: 22px; min-height: 56px; border-radius: 12px; background: var(--terracotta); color: #fff; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }

         .success-dialog {
            position: fixed;
            inset: 0;
            z-index: 74;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
             background: rgba(49, 48, 48, .38);
        }
        .success-dialog.open { display: flex; }
        .success-panel {
            width: min(100%, 620px);
            border-radius: 18px;
            border: 1px solid var(--outline-variant);
            background: var(--surface-lowest);
            padding: 30px;
            text-align: center;
             box-shadow: 0 18px 56px rgba(44, 44, 44, .2);
        }
        .success-icon {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            margin: 0 auto 16px;
            display: grid;
            place-items: center;
            background: var(--surface-container);
            color: var(--terracotta);
        }
        .success-panel h3 { margin: 0; font-family: 'Noto Serif', serif; font-size: 34px; }
        .success-panel p { margin: 10px 0; color: var(--on-surface-variant); line-height: 1.6; }
        .success-order { margin: 18px auto 0; border-radius: 10px; padding: 14px; background: var(--surface-low); max-width: 320px; }
        .success-order b { color: var(--terracotta); font-family: 'Noto Serif', serif; font-size: 34px; }

         .site-footer { border-top: 1px solid rgba(219, 193, 186, .68); background: var(--warm-beige); color: var(--on-surface-variant); }
        .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 82px; }

        @@media (max-width: 1080px) {
            .hero { grid-template-columns: 1fr; }
            .feature-card { max-width: 560px; }
            .menu-layout { grid-template-columns: 1fr; }
            .menu-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @@media (max-width: 760px) {
            .page-shell { width: min(100% - 32px, 1180px); }
            .site-nav { min-height: 72px; }
            .brand-subtitle, .nav-links, .outline-link { display: none; }
            .table-pill, .primary-link { min-height: 40px; padding: 0 13px; font-size: 13px; }
            .hero { padding: 48px 0 36px; gap: 30px; }
            .hero-title { font-size: clamp(38px, 12vw, 52px); }
            .hero-copy { font-size: 16px; }
            .toolbar { grid-template-columns: 1fr; }
            .section-heading { display: block; }
            .section-heading p { margin-top: 10px; }
            .menu-grid { gap: 18px; }
            .menu-title { font-size: 23px; min-height: auto; }
            .menu-price-inline { font-size: 19px; }
            .footer-inner { display: block; padding: 22px 0; }
            .item-modal { padding: 0; align-items: end; }
            .item-modal-panel {
                width: 100%;
                border-radius: 20px 20px 0 0;
                grid-template-columns: 1fr;
                max-height: 90dvh;
                overflow: auto;
            }
            .item-modal-image { min-height: 260px; }
            .table-actions { grid-template-columns: 1fr; }
        }

        @@media (max-width: 520px) {
            .menu-grid { grid-template-columns: 1fr; }
            .hero-actions { display: grid; }
            .feature-title { font-size: 26px; }
            .cart-panel { padding: 18px; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <nav class="site-nav page-shell" aria-label="Navigasi utama">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true"><span class="material-symbols-outlined">restaurant</span></span>
                <span class="brand-text">
                    <span class="brand-name">Nusantara Heritage</span>
                    <span class="brand-subtitle">Authentic Indonesian Fine Dining</span>
                </span>
            </a>
            <div class="nav-links">
                <a href="#menu">Menu</a>
                <a href="#cara-pesan">Cara Pesan</a>
                <button type="button" id="openCartButton" style="background:none;padding:0;color:inherit;font:inherit;">Keranjang</button>
            </div>
            <div class="nav-actions">
                <button type="button" class="table-pill" id="openTableDialog">
                    <span class="material-symbols-outlined">table_restaurant</span>
                    Meja <span id="tableBadgeValue">@tableNumber</span>
                </button>
                <button type="button" class="cart-trigger" id="openCartIconButton" aria-label="Buka keranjang">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    <span class="cart-trigger-badge" id="cartCountBadge">0</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(dashboardUrl))
                {
                    <a class="outline-link" href="@dashboardUrl">Dashboard</a>
                }
                <button type="button" class="primary-link" id="openCartPrimaryButton">Pesan</button>
            </div>
        </nav>
    </header>

    <main>
        <section class="hero page-shell" id="cara-pesan">
            <div>
                <p class="eyebrow">Nusantara Heritage</p>
                <h1 class="hero-title">Menu utama dengan sentuhan warisan kuliner Nusantara.</h1>
                <p class="hero-copy">Nikmati persembahan hidangan otentik yang merayakan rempah, teknik masak tradisional, dan presentasi modern. Pilih menu, atur jumlah, lalu kirim langsung dari meja Anda.</p>
                <div class="hero-actions">
                    <a class="hero-button primary" href="#menu">
                        Lihat Menu
                        <span class="material-symbols-outlined">arrow_downward</span>
                    </a>
                    <button type="button" class="hero-button secondary" id="heroTableButton">
                        Ganti Nomor Meja
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                </div>
            </div>
            @if (featuredProduct != null)
            {
                var featuredImage = string.IsNullOrWhiteSpace(featuredProduct.ImageFileName)
                    ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1000&q=80"
                    : $"/products/{featuredProduct.ImageFileName}";
                <aside class="feature-card" aria-label="Rekomendasi chef">
                    <img class="feature-image" src="@featuredImage" alt="@featuredProduct.Name" />
                    <div class="feature-body">
                        <span class="feature-label">Chef's Recommendation</span>
                        <h2 class="feature-title">@featuredProduct.Name</h2>
                        <div class="feature-meta">
                            <span>Rp @featuredProduct.Price.ToString("N0", culture)</span>
                            <span class="material-symbols-outlined" aria-hidden="true">local_dining</span>
                        </div>
                    </div>
                </aside>
            }
        </section>

        <section class="menu-section page-shell" id="menu">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Menu Pilihan</p>
                    <h2>Hidangan hari ini</h2>
                </div>
                <p>Gunakan pencarian dan kategori untuk menemukan menu favorit. Stok menu otomatis mengikuti data restoran.</p>
            </div>

            <div class="toolbar">
                <div class="search-box">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input id="menuSearch" type="search" placeholder="Cari menu favoritmu..." autocomplete="off" />
                </div>
                <nav class="category-strip" aria-label="Kategori menu">
                    <button type="button" class="category-chip active" data-category="">Semua</button>
                    @foreach (var category in categories)
                    {
                        <button type="button" class="category-chip" data-category="@category">@category</button>
                    }
                </nav>
            </div>

            <div class="menu-layout">
                <div class="menu-grid" aria-label="Daftar menu">
                    @if (products.Count == 0)
                    {
                        <div class="empty-state">
                            <h2>Menu belum tersedia</h2>
                            <p>Silakan panggil staf restoran untuk bantuan pemesanan.</p>
                        </div>
                    }
                    else
                    {
                        for (var i = 0; i < products.Count; i++)
                        {
                            var product = products[i];
                            var categoryLabel = string.IsNullOrWhiteSpace(product.Category) ? "Menu" : product.Category;
                            var imageSrc = string.IsNullOrWhiteSpace(product.ImageFileName)
                                ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80"
                                : $"/products/{product.ImageFileName}";
                            var detail = string.IsNullOrWhiteSpace(product.Category)
                                ? "Hidangan pilihan dapur dengan cita rasa Nusantara modern."
                                : $"Menu kategori {product.Category} dengan rasa yang diracik untuk pengalaman makan di tempat.";
                            <article class="menu-card"
                                     data-product-card
                                     data-product-id="@product.Id"
                                     data-category="@categoryLabel"
                                     data-name="@product.Name.ToLowerInvariant()"
                                     data-product-name="@product.Name"
                                     data-product-category="@categoryLabel"
                                     data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)"
                                     data-product-image="@imageSrc"
                                     data-product-detail="@detail">
                                <div class="menu-image-wrap">
                                    <button type="button" class="menu-open" data-open-item="@product.Id" aria-label="Lihat detail @product.Name"></button>
                                    <img class="menu-image" src="@imageSrc" alt="@product.Name" loading="lazy" />
                                    @if (i == 0)
                                    {
                                        <span class="chef-badge">Chef's Rec</span>
                                    }
                                    <button type="button"
                                            class="fab-add"
                                            data-cart-action="add"
                                            data-product-id="@product.Id"
                                            data-product-name="@product.Name"
                                            data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)"
                                            aria-label="Tambah @product.Name">
                                        <span class="material-symbols-outlined">add</span>
                                    </button>
                                </div>
                                <div class="menu-body">
                                    <div class="menu-heading">
                                        <button type="button" class="menu-title" data-open-item="@product.Id">@product.Name</button>
                                        <span class="menu-price-inline">Rp @product.Price.ToString("N0", culture)</span>
                                    </div>
                                    <p class="menu-detail">@detail</p>
                                    <div class="menu-meta">
                                        <span class="menu-tag">@categoryLabel</span>
                                    </div>
                                    <button type="button"
                                            class="add-button @(i == 0 ? "primary" : string.Empty)"
                                            data-cart-action="add"
                                            data-product-id="@product.Id"
                                            data-product-name="@product.Name"
                                            data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)">
                                        <span class="material-symbols-outlined">add</span>
                                        Tambah
                                    </button>
                                    <div class="quantity-control" aria-label="Jumlah @product.Name">
                                        <button type="button" class="qty-button" data-cart-action="decrease" data-product-id="@product.Id" aria-label="Kurangi @product.Name">
                                            <span class="material-symbols-outlined">remove</span>
                                        </button>
                                        <span class="qty-value" data-qty-for="@product.Id">0</span>
                                        <button type="button" class="qty-button" data-cart-action="increase" data-product-id="@product.Id" aria-label="Tambah @product.Name">
                                            <span class="material-symbols-outlined">add</span>
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                        <div class="empty-state" id="filterEmptyState" style="display:none;">
                            <h2>Menu tidak ditemukan</h2>
                            <p>Coba kata kunci atau kategori lain.</p>
                        </div>
                    }
                </div>

                <div></div>
            </div>
        </section>
    </main>

    <div class="cart-backdrop" id="cartBackdrop"></div>
    <aside class="cart-drawer" id="cartDrawer" aria-label="Keranjang pesanan">
        <div class="cart-drawer-header">
            <h3 class="cart-drawer-title">Keranjang</h3>
            <button type="button" class="cart-drawer-close" id="closeCartDrawer" aria-label="Tutup keranjang">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="cart-drawer-body">
            <p class="cart-note">Pesanan akan dikirim untuk Meja <strong id="cartTableNumber">@tableNumber</strong>.</p>
            <div id="cartItems"></div>
            <div class="checkout-card">
                <h4>Catatan Pesanan</h4>
                <textarea class="checkout-note" id="orderNote" placeholder="Contoh: Tolong pisahkan sambal, tidak pakai daun bawang..."></textarea>
            </div>
            <div class="checkout-card">
                <h4>Metode Pembayaran</h4>
                <button type="button" class="payment-option active">
                    <span class="material-symbols-outlined">point_of_sale</span>
                    Bayar di Kasir
                </button>
                <button type="button" class="payment-option" disabled>
                    <span class="material-symbols-outlined">qr_code_scanner</span>
                    QRIS (segera hadir)
                </button>
            </div>
            <div class="cart-total">
                <span>Total</span>
                <strong id="cartTotal">Rp 0</strong>
            </div>
            <button type="button" class="submit-button" id="submitOrderBtn" disabled>Kirim Pesanan</button>
            <button type="button" class="secondary-button" id="clearCartBtn">Kosongkan Keranjang</button>
            <div id="orderFeedback" class="feedback"></div>
        </div>
    </aside>

    <div class="table-dialog" id="tableDialog" role="dialog" aria-modal="true" aria-labelledby="tableDialogTitle">
        <div class="table-panel">
            <h2 id="tableDialogTitle">Nomor meja</h2>
            <p>Pilih meja yang tersedia, lalu lanjut sebagai pemesan umum atau member.</p>
            <select class="table-select" id="tableSelect" aria-label="Pilih meja">
                <option value="">-- Pilih meja --</option>
                @foreach (var table in activeTables)
                {
                    <option value="@table.Number" data-token="@table.QrCodeToken">Meja @table.Number (Kapasitas @table.Capacity)</option>
                }
            </select>
            <div class="table-actions">
                <button type="button" class="table-action-button guest" id="continueGuestButton">Lanjut sebagai Umum</button>
                <button type="button" class="table-action-button member" id="continueMemberButton">Lanjut sebagai Member</button>
            </div>
            <button type="button" class="secondary-button" id="closeTableDialog">Tutup</button>
            <div id="tableFeedback" class="feedback"></div>
        </div>
    </div>

    <div class="auth-dialog" id="authDialog" role="dialog" aria-modal="true" aria-labelledby="authDialogTitle">
        <div class="auth-panel">
            <h3 id="authDialogTitle">Login Member</h3>
            <p>Masuk sebagai member untuk melanjutkan pemesanan meja.</p>
            <div class="auth-tabs">
                <button type="button" class="auth-tab active" id="authLoginTab">Login</button>
                <button type="button" class="auth-tab" id="authRegisterTab">Register</button>
            </div>

            <div id="loginForm">
                <div class="auth-group">
                    <label for="authLoginUsername">Username</label>
                    <input class="auth-input" id="authLoginUsername" type="text" autocomplete="username" />
                </div>
                <div class="auth-group">
                    <label for="authLoginPassword">Password</label>
                    <input class="auth-input" id="authLoginPassword" type="password" autocomplete="current-password" />
                </div>
            </div>

            <div id="registerForm" style="display:none;">
                <div class="auth-group">
                    <label for="authRegName">Nama Lengkap</label>
                    <input class="auth-input" id="authRegName" type="text" autocomplete="name" />
                </div>
                <div class="auth-group">
                    <label for="authRegUsername">Username</label>
                    <input class="auth-input" id="authRegUsername" type="text" autocomplete="username" />
                </div>
                <div class="auth-group">
                    <label for="authRegPassword">Password</label>
                    <input class="auth-input" id="authRegPassword" type="password" autocomplete="new-password" />
                </div>
            </div>

            <button type="button" class="submit-button" id="authSubmitButton">Lanjut</button>
            <button type="button" class="secondary-button" id="closeAuthDialog">Lewati dulu</button>
            <div class="auth-error" id="authError"></div>
        </div>
    </div>

    <div class="item-modal" id="itemModal" role="dialog" aria-modal="true" aria-labelledby="itemModalTitle">
        <div class="item-modal-panel">
            <button type="button" class="item-modal-close" id="closeItemModal" aria-label="Tutup detail menu">
                <span class="material-symbols-outlined">close</span>
            </button>
            <img class="item-modal-image" id="itemModalImage" src="" alt="Detail menu" />
            <div class="item-modal-content">
                <h2 class="item-modal-title" id="itemModalTitle">Menu</h2>
                <div class="item-modal-category" id="itemModalCategory">Kategori</div>
                <p class="item-modal-desc" id="itemModalDescription"></p>
                <div class="item-modal-foot">
                    <span class="item-modal-price" id="itemModalPrice">Rp 0</span>
                    <div class="quantity-control active">
                        <button type="button" class="qty-button" id="itemModalDecrease" aria-label="Kurangi jumlah detail"><span class="material-symbols-outlined">remove</span></button>
                        <span class="qty-value" id="itemModalQty">1</span>
                        <button type="button" class="qty-button" id="itemModalIncrease" aria-label="Tambah jumlah detail"><span class="material-symbols-outlined">add</span></button>
                    </div>
                </div>
                <button type="button" class="item-modal-add" id="itemModalAdd">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    Tambah ke Keranjang
                </button>
            </div>
        </div>
    </div>

    <div class="success-dialog" id="successDialog" role="dialog" aria-modal="true" aria-labelledby="successTitle">
        <div class="success-panel">
            <div class="success-icon"><span class="material-symbols-outlined" style="font-size:48px;font-variation-settings:'FILL' 1;">check_circle</span></div>
            <h3 id="successTitle">Terima kasih!</h3>
            <p>Pesanan Anda sudah diteruskan ke dapur. Silakan tunggu hidangan disajikan ke meja Anda.</p>
            <div class="success-order">
                <div>Nomor Pesanan</div>
                <b id="successOrderNumber">-</b>
            </div>
            <button type="button" class="submit-button" id="successCloseBtn">Kembali ke Menu</button>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-inner page-shell">
            <span>Nusantara Resto</span>
            <span>Pesan dari meja, diproses langsung oleh dapur.</span>
        </div>
    </footer>

    <script>
        (function () {
            'use strict';

            const COOKIE_TABLE = 'nr_tableNumber';
            const COOKIE_TABLE_TOKEN = 'nr_tableToken';
            const COOKIE_MEMBER = 'nr_membershipStatus';
            const CART_STORAGE_KEY = 'nr_orderCart';

            const tableBadgeValue = document.getElementById('tableBadgeValue');
            const cartTableNumber = document.getElementById('cartTableNumber');
            const tableDialog = document.getElementById('tableDialog');
            const tableSelect = document.getElementById('tableSelect');
            const tableFeedback = document.getElementById('tableFeedback');
            const continueGuestButton = document.getElementById('continueGuestButton');
            const continueMemberButton = document.getElementById('continueMemberButton');
            const openCartButtons = [
                document.getElementById('openCartButton'),
                document.getElementById('openCartIconButton'),
                document.getElementById('openCartPrimaryButton')
            ].filter(Boolean);
            const cartCountBadge = document.getElementById('cartCountBadge');
            const cartBackdrop = document.getElementById('cartBackdrop');
            const cartDrawer = document.getElementById('cartDrawer');
            const closeCartDrawer = document.getElementById('closeCartDrawer');
            const searchInput = document.getElementById('menuSearch');
            const filterEmptyState = document.getElementById('filterEmptyState');
            const cartItems = document.getElementById('cartItems');
            const cartTotal = document.getElementById('cartTotal');
            const submitOrderBtn = document.getElementById('submitOrderBtn');
            const clearCartBtn = document.getElementById('clearCartBtn');
            const orderFeedback = document.getElementById('orderFeedback');
            const itemModal = document.getElementById('itemModal');
            const itemModalImage = document.getElementById('itemModalImage');
            const itemModalTitle = document.getElementById('itemModalTitle');
            const itemModalCategory = document.getElementById('itemModalCategory');
            const itemModalDescription = document.getElementById('itemModalDescription');
            const itemModalPrice = document.getElementById('itemModalPrice');
            const itemModalQty = document.getElementById('itemModalQty');
            const itemModalAdd = document.getElementById('itemModalAdd');
            const successDialog = document.getElementById('successDialog');
            const successOrderNumber = document.getElementById('successOrderNumber');
            const authDialog = document.getElementById('authDialog');
            const authLoginTab = document.getElementById('authLoginTab');
            const authRegisterTab = document.getElementById('authRegisterTab');
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const authSubmitButton = document.getElementById('authSubmitButton');
            const closeAuthDialog = document.getElementById('closeAuthDialog');
            const authError = document.getElementById('authError');
            const authLoginUsername = document.getElementById('authLoginUsername');
            const authLoginPassword = document.getElementById('authLoginPassword');
            const authRegName = document.getElementById('authRegName');
            const authRegUsername = document.getElementById('authRegUsername');
            const authRegPassword = document.getElementById('authRegPassword');
            const activeTableOptions = Array.from(tableSelect ? tableSelect.options : []).map(option => ({
                number: option.value,
                token: option.getAttribute('data-token') || ''
            })).filter(option => option.number);
            const isAuthenticated = @isAuthenticated.ToString().ToLowerInvariant();
            const isCustomer = @isCustomer.ToString().ToLowerInvariant();
            let activeCategory = '';
            let cart = loadCart();
            let modalItem = null;
            let modalItemQty = 1;
            let authMode = 'login';

            function openCartDrawer() {
                cartDrawer.classList.add('open');
                cartBackdrop.classList.add('open');
                document.body.classList.add('no-scroll');
            }

            function closeCartPanel() {
                cartDrawer.classList.remove('open');
                cartBackdrop.classList.remove('open');
                document.body.classList.remove('no-scroll');
            }

            function setCookie(name, value, days) {
                const d = new Date();
                d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
                document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
            }

            function getCookie(name) {
                const nameEq = name + '=';
                const parts = document.cookie.split(';');
                for (let i = 0; i < parts.length; i++) {
                    const part = parts[i].trim();
                    if (part.indexOf(nameEq) === 0) return decodeURIComponent(part.substring(nameEq.length));
                }
                return null;
            }

            function loadCart() {
                try {
                    const parsed = JSON.parse(localStorage.getItem(CART_STORAGE_KEY) || '[]');
                    return Array.isArray(parsed) ? parsed : [];
                } catch {
                    return [];
                }
            }

            function saveCart() {
                localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
            }

            function formatCurrency(value) {
                return 'Rp ' + new Intl.NumberFormat('id-ID', { maximumFractionDigits: 0 }).format(Number(value) || 0);
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function normalizeTableNumber(value) {
                if (!value) return '--';
                return String(value).padStart(2, '0');
            }

            function setTableUi(value) {
                const normalized = normalizeTableNumber(value);
                tableBadgeValue.textContent = normalized;
                cartTableNumber.textContent = normalized;
            }

            function getSelectedTableOption() {
                const selected = tableSelect && tableSelect.selectedOptions ? tableSelect.selectedOptions[0] : null;
                if (!selected || !selected.value) return null;
                return {
                    number: selected.value,
                    token: selected.getAttribute('data-token') || ''
                };
            }

            function isTableActive(number) {
                return activeTableOptions.some(option => String(option.number) === String(number));
            }

            function setTableCookies(tableNumber, tableToken) {
                setCookie(COOKIE_TABLE, String(tableNumber), 365);
                if (tableToken) {
                    setCookie(COOKIE_TABLE_TOKEN, tableToken, 365);
                }
            }

            async function postJson(url, payload) {
                const token = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';
                const res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });
                return await res.json();
            }

            function findCartItem(productId) {
                return cart.find(item => Number(item.productId) === Number(productId));
            }

            function addToCart(productId, name, price, qty) {
                const quantity = Math.max(1, Number(qty) || 1);
                const existing = findCartItem(productId);
                if (existing) {
                    existing.qty += quantity;
                } else {
                    cart.push({
                        productId: Number(productId),
                        name: name || 'Menu',
                        price: Number(price || 0),
                        qty: quantity
                    });
                }
            }

            function updateItem(productId, delta, sourceButton) {
                const existing = findCartItem(productId);
                if (existing) {
                    existing.qty += delta;
                } else if (delta > 0 && sourceButton) {
                    addToCart(
                        Number(productId),
                        sourceButton.dataset.productName || 'Menu',
                        Number(sourceButton.dataset.productPrice || 0),
                        1
                    );
                }

                cart = cart.filter(item => Number(item.qty) > 0);
                saveCart();
                renderCart();
                setFeedback('', '');
            }

            function setFeedback(message, type) {
                orderFeedback.textContent = message || '';
                orderFeedback.className = 'feedback' + (type ? ' ' + type : '');
            }

            function renderCart() {
                const totalQty = cart.reduce((sum, item) => sum + Number(item.qty || 0), 0);
                const total = cart.reduce((sum, item) => sum + (Number(item.price || 0) * Number(item.qty || 0)), 0);

                document.querySelectorAll('[data-product-card]').forEach(card => {
                    const productId = Number(card.dataset.productId);
                    const item = findCartItem(productId);
                    card.classList.toggle('is-in-cart', !!item);
                    const qty = card.querySelector('[data-qty-for="' + productId + '"]');
                    if (qty) qty.textContent = item ? item.qty : '0';
                });

                cartTotal.textContent = formatCurrency(total);
                if (cartCountBadge) {
                    cartCountBadge.textContent = String(totalQty);
                    cartCountBadge.classList.toggle('visible', totalQty > 0);
                }
                submitOrderBtn.disabled = totalQty === 0;

                if (cart.length === 0) {
                    cartItems.innerHTML = '<div class="cart-empty">Belum ada menu di keranjang.</div>';
                    return;
                }

                cartItems.innerHTML = cart.map(item => [
                    '<div class="cart-item">',
                    '<div class="cart-item-main">',
                    '<p class="cart-item-title">' + escapeHtml(item.name) + '</p>',
                    '<div class="cart-item-price">' + escapeHtml(String(item.qty)) + ' x ' + formatCurrency(item.price) + '</div>',
                    '<div class="qty-pill">Qty: ' + escapeHtml(String(item.qty)) + '</div>',
                    '</div>',
                    '<div class="quantity-control active">',
                    '<button type="button" class="qty-button" data-cart-action="decrease" data-product-id="' + item.productId + '"><span class="material-symbols-outlined">remove</span></button>',
                    '<span class="qty-value">' + item.qty + '</span>',
                    '<button type="button" class="qty-button" data-cart-action="increase" data-product-id="' + item.productId + '"><span class="material-symbols-outlined">add</span></button>',
                    '</div>',
                    '</div>'
                ].join('')).join('');
            }

            function applyFilter() {
                const query = (searchInput.value || '').trim().toLowerCase();
                let visibleCount = 0;
                document.querySelectorAll('[data-product-card]').forEach(card => {
                    const matchesCategory = !activeCategory || String(card.dataset.category || '').toLowerCase() === activeCategory.toLowerCase();
                    const matchesQuery = !query || String(card.dataset.name || '').includes(query);
                    const visible = matchesCategory && matchesQuery;
                    card.style.display = visible ? '' : 'none';
                    if (visible) visibleCount += 1;
                });
                if (filterEmptyState) filterEmptyState.style.display = visibleCount === 0 ? '' : 'none';
            }

            function openTableDialog() {
                tableFeedback.textContent = '';
                tableFeedback.className = 'feedback';
                const currentTable = getCookie(COOKIE_TABLE) || '';
                if (tableSelect) {
                    tableSelect.value = isTableActive(currentTable) ? String(currentTable) : '';
                }
                tableDialog.classList.add('open');
                if (tableSelect) tableSelect.focus();
            }

            function closeAuthModal() {
                authDialog.classList.remove('open');
                authError.textContent = '';
            }

            function openAuthModal() {
                authError.textContent = '';
                authDialog.classList.add('open');
                if (authMode === 'login') {
                    authLoginUsername.focus();
                } else {
                    authRegName.focus();
                }
            }

            function setAuthMode(mode) {
                authMode = mode === 'register' ? 'register' : 'login';
                authLoginTab.classList.toggle('active', authMode === 'login');
                authRegisterTab.classList.toggle('active', authMode === 'register');
                loginForm.style.display = authMode === 'login' ? '' : 'none';
                registerForm.style.display = authMode === 'register' ? '' : 'none';
                authError.textContent = '';
            }

            function setModalQty(value) {
                modalItemQty = Math.max(1, Number(value) || 1);
                itemModalQty.textContent = String(modalItemQty);
            }

            function openItemModal(productId) {
                const card = document.querySelector('[data-product-card][data-product-id="' + Number(productId) + '"]');
                if (!card) return;

                modalItem = {
                    productId: Number(card.dataset.productId),
                    name: card.dataset.productName || 'Menu',
                    category: card.dataset.productCategory || 'Menu',
                    detail: card.dataset.productDetail || '',
                    image: card.dataset.productImage || '',
                    price: Number(card.dataset.productPrice || 0)
                };

                itemModalImage.src = modalItem.image;
                itemModalImage.alt = modalItem.name;
                itemModalTitle.textContent = modalItem.name;
                itemModalCategory.textContent = String(modalItem.category).toUpperCase();
                itemModalDescription.textContent = modalItem.detail;
                itemModalPrice.textContent = formatCurrency(modalItem.price);
                setModalQty(1);
                itemModal.classList.add('open');
            }

            function closeItemModal() {
                itemModal.classList.remove('open');
            }

            async function postOrder() {
                const tableNumber = getCookie(COOKIE_TABLE);
                const tableToken = getCookie(COOKIE_TABLE_TOKEN) || document.querySelector('meta[name="table-token"]')?.getAttribute('content') || null;
                const membershipStatus = getCookie(COOKIE_MEMBER) || 'Guest';

                if (!tableNumber) {
                    setFeedback('Nomor meja belum dipilih.', 'error');
                    openTableDialog();
                    return;
                }

                if (cart.length === 0) {
                    setFeedback('Keranjang masih kosong.', 'error');
                    return;
                }

                submitOrderBtn.disabled = true;
                setFeedback('Mengirim pesanan...', 'success');

                try {
                    const data = await postJson('/CustomerOrder/Submit', {
                        tableNumber: Number(tableNumber),
                        tableToken: tableToken || null,
                        membershipStatus: membershipStatus,
                        items: cart.map(item => ({ productId: Number(item.productId), qty: Number(item.qty) }))
                    });
                    if (!data || !data.success) {
                        setFeedback((data && data.error) || 'Pesanan gagal dikirim.', 'error');
                        renderCart();
                        return;
                    }

                    cart = [];
                    saveCart();
                    renderCart();
                    setFeedback('Pesanan berhasil dikirim. Nomor order: ' + data.orderNumber + '.', 'success');
                    successOrderNumber.textContent = data.orderNumber || '-';
                    successDialog.classList.add('open');
                } catch {
                    setFeedback('Terjadi error saat mengirim pesanan.', 'error');
                } finally {
                    renderCart();
                }
            }

            document.addEventListener('click', event => {
                const openButton = event.target.closest('[data-open-item]');
                if (openButton) {
                    openItemModal(openButton.getAttribute('data-open-item'));
                    return;
                }

                const actionButton = event.target.closest('[data-cart-action]');
                if (actionButton) {
                    const action = actionButton.dataset.cartAction;
                    const delta = action === 'decrease' ? -1 : 1;
                    updateItem(actionButton.dataset.productId, delta, actionButton);
                    return;
                }

                const chip = event.target.closest('.category-chip');
                if (chip) {
                    document.querySelectorAll('.category-chip').forEach(item => item.classList.remove('active'));
                    chip.classList.add('active');
                    activeCategory = chip.dataset.category || '';
                    applyFilter();
                }
            });

            document.getElementById('openTableDialog').addEventListener('click', openTableDialog);
            document.getElementById('heroTableButton').addEventListener('click', openTableDialog);
            document.getElementById('closeTableDialog').addEventListener('click', () => tableDialog.classList.remove('open'));
            openCartButtons.forEach(button => {
                button.addEventListener('click', openCartDrawer);
            });
            closeCartDrawer.addEventListener('click', closeCartPanel);
            cartBackdrop.addEventListener('click', closeCartPanel);
            continueGuestButton.addEventListener('click', () => {
                const selected = getSelectedTableOption();
                if (!selected) {
                    tableFeedback.textContent = 'Silakan pilih meja yang tersedia.';
                    tableFeedback.className = 'feedback error';
                    if (tableSelect) tableSelect.focus();
                    return;
                }

                setTableCookies(selected.number, selected.token);
                setCookie(COOKIE_MEMBER, 'Guest', 365);
                setTableUi(selected.number);
                tableDialog.classList.remove('open');
                setFeedback('Mode umum aktif. Anda bisa langsung memesan.', 'success');
            });

            continueMemberButton.addEventListener('click', () => {
                const selected = getSelectedTableOption();
                if (!selected) {
                    tableFeedback.textContent = 'Silakan pilih meja yang tersedia.';
                    tableFeedback.className = 'feedback error';
                    if (tableSelect) tableSelect.focus();
                    return;
                }

                setTableCookies(selected.number, selected.token);
                setCookie(COOKIE_MEMBER, 'Member', 365);
                setTableUi(selected.number);
                tableDialog.classList.remove('open');

                setAuthMode('login');
                openAuthModal();
                setFeedback('Mode member aktif. Login member tersedia, atau lewati dulu untuk lanjut pesan.', 'success');
            });

            document.getElementById('closeItemModal').addEventListener('click', closeItemModal);
            document.getElementById('itemModalDecrease').addEventListener('click', () => setModalQty(modalItemQty - 1));
            document.getElementById('itemModalIncrease').addEventListener('click', () => setModalQty(modalItemQty + 1));
            itemModalAdd.addEventListener('click', () => {
                if (!modalItem) return;
                addToCart(modalItem.productId, modalItem.name, modalItem.price, modalItemQty);
                saveCart();
                renderCart();
                setFeedback('Menu ditambahkan ke keranjang.', 'success');
                closeItemModal();
            });
            tableDialog.addEventListener('click', event => {
                if (event.target === tableDialog) tableDialog.classList.remove('open');
            });
            itemModal.addEventListener('click', event => {
                if (event.target === itemModal) closeItemModal();
            });
            successDialog.addEventListener('click', event => {
                if (event.target === successDialog) successDialog.classList.remove('open');
            });
            authDialog.addEventListener('click', event => {
                if (event.target === authDialog) closeAuthModal();
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    tableDialog.classList.remove('open');
                    closeItemModal();
                    successDialog.classList.remove('open');
                    closeAuthModal();
                    closeCartPanel();
                }
            });

            document.getElementById('successCloseBtn').addEventListener('click', () => successDialog.classList.remove('open'));
            authLoginTab.addEventListener('click', () => setAuthMode('login'));
            authRegisterTab.addEventListener('click', () => setAuthMode('register'));
            closeAuthDialog.addEventListener('click', closeAuthModal);

            authSubmitButton.addEventListener('click', async () => {
                authError.textContent = '';
                authSubmitButton.disabled = true;

                try {
                    if (authMode === 'login') {
                        const username = String(authLoginUsername.value || '').trim();
                        const password = String(authLoginPassword.value || '');
                        if (!username || !password) {
                            authError.textContent = 'Username dan password wajib diisi.';
                            return;
                        }

                        const data = await postJson('/Auth/AjaxLogin', { username, password });
                        if (!data || !data.success) {
                            authError.textContent = (data && data.error) || 'Login gagal.';
                            return;
                        }

                        window.location.href = data.redirectUrl || '/';
                        return;
                    }

                    const fullName = String(authRegName.value || '').trim();
                    const username = String(authRegUsername.value || '').trim();
                    const password = String(authRegPassword.value || '');
                    if (!fullName || !username || !password) {
                        authError.textContent = 'Nama, username, dan password wajib diisi.';
                        return;
                    }

                    const data = await postJson('/Auth/AjaxRegister', { fullName, username, password });
                    if (!data || !data.success) {
                        authError.textContent = (data && data.error) || 'Register gagal.';
                        return;
                    }

                    window.location.href = data.redirectUrl || '/';
                } catch {
                    authError.textContent = 'Terjadi kesalahan jaringan. Silakan coba lagi.';
                } finally {
                    authSubmitButton.disabled = false;
                }
            });

            clearCartBtn.addEventListener('click', () => {
                cart = [];
                saveCart();
                renderCart();
                setFeedback('', '');
            });
            submitOrderBtn.addEventListener('click', postOrder);
            searchInput.addEventListener('input', applyFilter);

            const currentTable = getCookie(COOKIE_TABLE);
            if (currentTable && isTableActive(currentTable)) {
                setTableUi(currentTable);
            } else {
                setCookie(COOKIE_TABLE, '', -1);
                setCookie(COOKIE_TABLE_TOKEN, '', -1);
                setTableUi(null);
            }

            if (!getCookie(COOKIE_MEMBER)) setCookie(COOKIE_MEMBER, 'Guest', 365);
            renderCart();
            applyFilter();

            if (!getCookie(COOKIE_TABLE)) {
                openTableDialog();
            }
        })();
    </script>
</body>
</html>
