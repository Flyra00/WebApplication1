@{
    ViewData["Title"] = "Privacy Policy";
}
<main class="page-shell" style="padding:40px 0 72px;">
    <section style="display:grid;gap:18px;max-width:760px;padding:28px;border-radius:28px;background:rgba(255,255,255,.78);border:1px solid rgba(224,192,178,.72);box-shadow:0 18px 44px rgba(44,44,44,.08);">
        <p style="margin:0;color:var(--forest);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;">Nusantara Heritage</p>
        <h1 style="margin:0;font-family:'Noto Serif',serif;font-size:clamp(32px,4vw,44px);color:var(--terracotta-dark);">@ViewData["Title"]</h1>
        <p style="margin:0;color:var(--on-surface-variant);line-height:1.7;">Halaman ini dapat digunakan untuk menjelaskan kebijakan privasi, pengelolaan data reservasi, dan komunikasi pelanggan pada kanal publik Nusantara Heritage.</p>
    </section>
</main>
