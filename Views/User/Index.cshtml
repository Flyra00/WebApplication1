@model List<ApplicationUser>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Daftar User";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold text-dark"><i class="bi bi-people-fill me-2"></i>Manajemen User</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                    <i class="bi bi-person-plus-fill me-1"></i> Tambah User
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold mb-0">Daftar User Sistem</h3>
                <span class="badge bg-light text-dark border">Total: @Model.Count</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase small fw-bold">
                            <tr>
                                <th class="ps-4">Username</th>
                                <th>Full Name</th>
                                <th>Role</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">Belum ada user yang terdaftar.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var user in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@user.UserName</td>
                                        <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)</td>
                                        <td>
                                            @if (user.Roles.Count == 0)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">No Role</span>
                                            }
                                            else
                                            {
                                                foreach (var role in user.Roles)
                                                {
                                                    var badgeClass = role switch
                                                    {
                                                        AppRoles.Admin => "bg-danger-subtle text-danger",
                                                        AppRoles.Owner => "bg-dark-subtle text-dark",
                                                        AppRoles.Supervisor => "bg-primary-subtle text-primary",
                                                        AppRoles.Kasir => "bg-success-subtle text-success",
                                                        AppRoles.Customer => "bg-warning-subtle text-warning",
                                                        AppRoles.Kitchen => "bg-info-subtle text-info",
                                                        _ => "bg-secondary-subtle text-secondary"
                                                    };

                                                    var roleLabel = role == AppRoles.Kitchen ? "Bagian Masak" : role;
                                                    <span class="badge @badgeClass border border-opacity-25 rounded-pill px-2 me-1">@roleLabel</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm" role="group">
                                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning btn-sm" title="Edit User">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('Yakin mau hapus user @user.UserName?')"
                                                            title="Delete User">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
