@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard Admin";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card h-100 text-center p-4">
            <i class="bi bi-people d-block mb-3" style="font-size:1.7rem;color:#f59e0b;"></i>
            <div class="display-6 fw-bold" style="color:#f59e0b;">User</div>
            <div class="text-muted">Kelola akun dan role</div>
            <a asp-controller="User" asp-action="Index" class="btn btn-primary btn-sm mt-3">Buka Modul</a>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 text-center p-4">
            <i class="bi bi-egg-fried d-block mb-3" style="font-size:1.7rem;color:#3b82f6;"></i>
            <div class="display-6 fw-bold" style="color:#3b82f6;">Menu</div>
            <div class="text-muted">Harga, stok, kategori</div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm mt-3">Buka Modul</a>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 text-center p-4">
            <i class="bi bi-grid-3x3-gap d-block mb-3" style="font-size:1.7rem;color:#22c55e;"></i>
            <div class="display-6 fw-bold" style="color:#22c55e;">Meja</div>
            <div class="text-muted">QR meja dan status</div>
            <a asp-controller="Table" asp-action="Index" class="btn btn-primary btn-sm mt-3">Buka Modul</a>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 text-center p-4">
            <i class="bi bi-receipt d-block mb-3" style="font-size:1.7rem;color:#ef4444;"></i>
            <div class="display-6 fw-bold" style="color:#ef4444;">Kasir</div>
            <div class="text-muted">Transaksi hari ini</div>
            <a asp-controller="Cashier" asp-action="Index" class="btn btn-primary btn-sm mt-3">Buka Modul</a>
        </div>
    </div>
</div>

<div class="card p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0">Akses Cepat Operasional</h5>
        <span class="text-muted small">Sistem Restoran</span>
    </div>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-controller="Ingredient" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-basket d-block mb-2"></i>Bahan Mentah
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-box-seam d-block mb-2"></i>Inventaris
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Kitchen" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-fire d-block mb-2"></i>Dapur
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Owner" asp-action="Dashboard" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-bar-chart-line d-block mb-2"></i>Owner Report
            </a>
        </div>
    </div>
</div>
