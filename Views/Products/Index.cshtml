@model List<Product>
@{
    var canManage = User?.IsInRole(AppRoles.Admin) ?? false;
    var canEdit = (User?.IsInRole(AppRoles.Admin) ?? false) || (User?.IsInRole(AppRoles.Supervisor) ?? false);
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Daftar Menu";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold text-dark"><i class="bi bi-list-stars me-2"></i>Daftar Menu Restoran</h1>
            </div>
            @if (canManage)
            {
                <div class="col-sm-6 text-end">
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                        <i class="bi bi-plus-lg me-1"></i> Tambah Menu Baru
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white py-3">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fw-bold">Menu Tersedia</h3>
                    </div>
                    <div class="col-auto">
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <input type="text" class="form-control" placeholder="Cari menu...">
                            <button class="btn btn-outline-secondary" type="button">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase small fw-bold">
                            <tr>
                                <th>Menu & Kategori</th>
                                <th class="text-center">Harga</th>
                                <th class="text-center">Diskon Member</th>
                                <th class="text-center">Stok</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Foto</th>
                                <th class="text-center">Tanggal Input</th>
                                @if (canManage)
                                {
                                    <th class="text-center pe-4">Aksi</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-bold text-dark">@product.Name</div>
                                        @{
                                            var badgeClass = product.Category switch
                                            {
                                                "Makanan" => "bg-primary-subtle text-primary",
                                                "Minuman" => "bg-success-subtle text-success",
                                                "Snack" => "bg-warning-subtle text-warning",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass border border-opacity-25 rounded-pill px-2" style="font-size: 0.75rem;">
                                            @product.Category
                                        </span>
                                    </td>
<td class="text-center fw-bold text-success">
                                        Rp @product.Price.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        @if (product.MemberDiscountPercentage.HasValue && product.MemberDiscountPercentage > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border">@product.MemberDiscountPercentage.Value.ToString("N0")%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(product.Stock > 0 ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger") border">
                                            @product.Stock
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (product.IsAvailable && product.Stock > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">Nonaktif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(product.ImageFileName))
                                        {
                                            <div class="position-relative d-inline-block">
                                                <img src="/products/@product.ImageFileName"
                                                     class="rounded-3 shadow-sm border"
                                                     style="width: 60px; height: 60px; object-fit: cover;"
                                                     alt="@product.Name" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded-3 border d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
<td class="text-center text-muted small">
                                        @product.Created.ToString("dd MMM yyyy")
                                    </td>
                                    @if (canEdit)
                                    {
                                        <td class="text-center pe-4">
                                            <div class="btn-group shadow-sm">
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-warning btn-sm" title="Edit Menu">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                @if (canManage)
                                                {
                                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm"
                                                       onclick="return confirm('Yakin mau hapus menu @product.Name?')" title="Delete Menu">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Total: @Model.Count Menu</small>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item disabled"><a class="page-link" href="#">Prev</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
