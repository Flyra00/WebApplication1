@model WebApplication1.Models.Product
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Create New Menu";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold text-dark">Manajemen Menu</h1>
            </div>
            <div class="col-sm-6 text-end">
                <small class="text-muted">Restoran Management System v1.0</small>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid pb-5">
        <div class="row">
            <div class="col-md-10 mx-auto">
                <div class="card card-primary card-outline shadow-lg border-0">
                    <div class="card-header bg-white py-3">
                        <h3 class="card-title fw-bold text-primary">
                            <i class="bi bi-plus-circle-fill me-2"></i> Tambah Menu Restoran Baru
                        </h3>
                    </div>

                    <form asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-md-7">
                                    <div class="mb-4">
                                        <label asp-for="Name" class="form-label fw-bold text-secondary">Nama Menu</label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-light"><i class="bi bi-egg-fried"></i></span>
                                            <input asp-for="Name" class="form-control" placeholder="Contoh: Nasi Goreng Gila Jakarta" />
                                        </div>
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>

<div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label asp-for="Category" class="form-label fw-bold text-secondary">Kategori</label>
                                            <select asp-for="Category" class="form-select shadow-sm">
                                                <option value="" selected disabled>-- Pilih Kategori --</option>
                                                <option value="Makanan">Makanan Utama</option>
                                                <option value="Minuman">Minuman Segar</option>
                                                <option value="Snack">Camilan / Snack</option>
                                            </select>
                                            <span asp-validation-for="Category" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="Price" class="form-label fw-bold text-secondary">Harga Jual</label>
                                            <div class="input-group shadow-sm">
                                                <span class="input-group-text bg-success text-white">Rp</span>
                                                <input asp-for="Price" type="number" class="form-control" placeholder='0' />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label asp-for="MemberDiscountPercentage" class="form-label fw-bold text-secondary">Diskon Member (%)</label>
                                            <div class="input-group shadow-sm">
                                                <input asp-for="MemberDiscountPercentage" type="number" min="0" max="100" step="0.01" class="form-control" placeholder="Contoh: 10" />
                                                <span class="input-group-text bg-warning text-dark">%</span>
                                            </div>
                                            <span asp-validation-for="MemberDiscountPercentage" class="text-danger small"></span>
                                            <div class="form-text text-muted">Kosongkan jika tidak ada diskon member.</div>
                                        </div>

                                        <div class="col-md-6 mb-4 d-flex align-items-end">
                                            <div class="form-check form-switch" style="margin-bottom: 1rem;">
                                                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                                                <label asp-for="IsAvailable" class="form-check-label fw-bold text-secondary">Tersedia untuk dijual</label>
                                            </div>
                                        </div>
                                    </div>

<div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label asp-for="Stock" class="form-label fw-bold text-secondary">Stok Menu</label>
                                            <input asp-for="Stock" type="number" min="0" class="form-control shadow-sm" placeholder="Contoh: 25" />
                                            <span asp-validation-for="Stock" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-5 border-start ps-4">
                                    <div class="mb-3 text-center">
                                        <label class="form-label fw-bold text-secondary">Preview Foto</label>
                                        <div class="mt-2 border rounded p-2 bg-light d-flex align-items-center justify-content-center shadow-inner"
                                             style="height: 220px; overflow: hidden; border-style: dashed !important; border-width: 2px;">
                                            <img id="imagePreview" src="~/images/no-image.png" alt="Preview" class="img-fluid rounded shadow-sm" style="max-height: 100%;" />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="FoodImage" class="form-label fw-bold text-secondary">Upload Gambar</label>
                                        <input type="file" name="ImageFile" class="form-control shadow-sm" id="FoodImage" accept="image/*" onchange="previewFile()" />
                                        <div class="form-text">Gunakan file JPG/PNG (Max 2MB).</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light py-3 text-end">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 me-2">
                                <i class="bi bi-arrow-left me-1"></i> Batal
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save-fill me-1"></i> Simpan Menu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function previewFile() {
            const preview = document.querySelector('#imagePreview');
            const file = document.querySelector('#FoodImage').files[0];
            const reader = new FileReader();

            reader.addEventListener("load", function () {
                preview.src = reader.result;
            }, false);

            if (file) {
                reader.readAsDataURL(file);
            }
        }
    </script>
}
