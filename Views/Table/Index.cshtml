@model List<Table>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Manajemen Meja";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold text-dark"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Manajemen Meja</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Meja
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold mb-0">Daftar Meja</h3>
                <span class="badge bg-light text-dark border">Total: @Model.Count</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase small fw-bold">
                            <tr>
                                <th class="ps-4">Nomor Meja</th>
                                <th>Kapasitas</th>
                                <th>Status</th>
                                <th>QR Order</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">Belum ada data meja.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var table in Model)
                                {
                                    var isOccupied = table.Sessions.Any(s => s.Status == TableSessionStatuses.Open && s.EndTime == null);
                                    var qrUrl = Url.Action("StartFromQr", "TableSession", new { token = table.QrCodeToken }, Context.Request.Scheme);
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">Meja @table.Number</td>
                                        <td><span class="badge bg-primary-subtle text-primary border">@table.Capacity Orang</span></td>
                                        <td>
                                            @if (!table.IsActive)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">Nonaktif</span>
                                            }
                                            else if (isOccupied)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border">Terisi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border">Kosong</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small text-muted mb-1">@qrUrl</div>
                                            <form asp-action="RegenerateToken" asp-route-id="@table.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        onclick="return confirm('Regenerate QR meja @table.Number? Link QR lama tidak bisa dipakai lagi.')">
                                                    <i class="bi bi-qr-code me-1"></i> Regenerate
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm" role="group">
                                                <a asp-action="Edit" asp-route-id="@table.Id" class="btn btn-outline-warning btn-sm" title="Edit Meja">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@table.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('Yakin mau hapus meja @table.Number?')"
                                                            title="Delete Meja">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
