@model WebApplication1.Models.Table
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Hapus Meja";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Konfirmasi Hapus Meja</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid pb-4">
        <div class="row">
            <div class="col-md-7 col-lg-6 mx-auto">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4 text-center">
                        <p class="mb-1 text-muted">Anda akan menghapus data meja berikut:</p>
                        <h5 class="fw-bold mb-1">Meja @Model.Number</h5>
                        <p class="mb-4 text-secondary">Kapasitas @Model.Capacity Orang</p>

                        <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Batal</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash-fill me-1"></i> Hapus
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
