@model WebApplication1.Models.Order
@{
    ViewData["Title"] = "Tiket Dapur";
    Layout = "~/Views/Shared/_LayoutOperational.cshtml";
}

<div class="no-print d-flex gap-2 mb-3 justify-content-end">
    <a asp-action="Index" class="op-btn op-btn-secondary"><i class="bi bi-arrow-left me-1"></i>Kembali</a>
    <button onclick="window.print()" class="op-btn op-btn-primary"><i class="bi bi-printer me-1"></i>Cetak Tiket Dapur</button>
</div>

<div class="row justify-content-center">
    <div class="col-sm-6 col-md-4">
        <div class="op-card" style="font-family:'Courier New',monospace;max-width:380px;margin:auto;border:2px dashed var(--op-border);">
            <div class="text-center mb-3">
                <h5 class="fw-bold mb-0" style="letter-spacing:.1em;">⚑ TIKET DAPUR ⚑</h5>
                <hr style="border-style:dashed;border-color:var(--op-border);" />
            </div>

            <div style="font-size:.9rem;" class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-bold">MEJA</span>
                    <span class="fw-bold" style="font-size:1.2rem;">@(Model.TableSession?.Table?.Number ?? 0)</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>No. Order</span>
                    <span>@Model.OrderNumber</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Waktu</span>
                    <span>@Model.OrderDate.ToLocalTime().ToString("HH:mm:ss")</span>
                </div>
            </div>

            <hr style="border-style:dashed;border-color:var(--op-border);" />

            @foreach (var item in Model.Items)
            {
                <div class="mb-3">
                    <div class="fw-bold" style="font-size:1rem;">@item.Qty× @item.Product?.Name</div>
                    @if (!string.IsNullOrWhiteSpace(item.Note))
                    {
                        <div style="font-size:.8rem;color:var(--op-muted);">→ Catatan: @item.Note</div>
                    }
                </div>
            }

            <hr style="border-style:dashed;border-color:var(--op-border);" />
            <div class="text-center" style="font-size:.75rem;color:var(--op-muted);">Dicetak: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</div>
        </div>
    </div>
</div>
