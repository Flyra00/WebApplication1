<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Owner Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        :root {
            --owner-bg: #0a0e1a;
            --owner-sidebar: #0d1220;
            --owner-surface: #131929;
            --owner-border: #1e2840;
            --owner-gold: #f59e0b;
            --owner-text: #e2e8f0;
            --owner-muted: #64748b;
        }
        body { font-family: 'Inter', sans-serif; background: var(--owner-bg); color: var(--owner-text); margin: 0; display: flex; min-height: 100vh; }
        .ow-sidebar {
            width: 240px; min-height: 100vh; background: var(--owner-sidebar);
            border-right: 1px solid var(--owner-border); padding: 1.5rem 0; flex-shrink: 0;
            display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; overflow-y: auto;
        }
        .ow-brand { padding: 0.5rem 1.5rem 1.5rem; border-bottom: 1px solid var(--owner-border); margin-bottom: 1rem; }
        .ow-brand h1 { font-size: 1.1rem; font-weight: 700; color: var(--owner-gold); margin: 0; }
        .ow-brand small { color: var(--owner-muted); font-size: 0.75rem; }
        .ow-nav-item a {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.6rem 1.5rem; color: var(--owner-muted);
            text-decoration: none; font-size: 0.875rem; transition: all 0.2s;
        }
        .ow-nav-item a:hover, .ow-nav-item a.active { color: var(--owner-text); background: rgba(255,255,255,0.05); }
        .ow-nav-item a.active { border-left: 3px solid var(--owner-gold); color: var(--owner-gold); }
        .ow-profile { margin: 1rem; padding: 1rem; border: 1px solid var(--owner-border); border-radius: .9rem; background: rgba(255,255,255,.025); }
        .ow-profile-name { color: var(--owner-text); font-size: .9rem; font-weight: 700; margin-bottom: .15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ow-profile-role { color: var(--owner-muted); font-size: .76rem; margin-bottom: .85rem; }
        .ow-profile-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
        .ow-profile-actions .btn { font-size: .78rem; border-color: #53627d; color: var(--owner-muted); }
        .ow-profile-actions .btn:hover { color: var(--owner-text); border-color: var(--owner-gold); }
        .ow-main { flex: 1; overflow: auto; }
        .ow-topbar {
            background: var(--owner-sidebar); border-bottom: 1px solid var(--owner-border);
            padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 10;
        }
        .ow-content { padding: 1.5rem; }
        .ow-card { background: var(--owner-surface); border: 1px solid var(--owner-border); border-radius: 12px; padding: 1.25rem; }
        .ow-stat-card { text-align: center; }
        .ow-stat-card .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--owner-gold); }
        .ow-stat-card .stat-label { color: var(--owner-muted); font-size: 0.8rem; margin-top: 0.25rem; }
        .ow-table { width: 100%; border-collapse: collapse; }
        .ow-table th { color: var(--owner-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--owner-border); padding: 0.75rem; }
        .ow-table td { padding: 0.875rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .ow-table tr:hover td { background: rgba(255,255,255,0.03); }
        @@media (max-width: 991.98px) {
            body { display: block; }
            .ow-sidebar { width: 100%; height: auto; min-height: auto; position: relative; }
            .ow-content { padding: 1rem; }
            .ow-topbar small { display: none; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <aside class="ow-sidebar">
        <div class="ow-brand">
            <h1><i class="bi bi-graph-up-arrow me-2"></i>OWNER</h1>
            <small>@User.Identity?.Name</small>
        </div>
        <nav>
            <div class="ow-nav-item">
                <a asp-controller="Owner" asp-action="Dashboard"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </div>
            <div class="ow-nav-item">
                <a asp-controller="Owner" asp-action="SalesReport"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "SalesReport" ? "active" : "")">
                    <i class="bi bi-bar-chart-line"></i> Laporan Penjualan
                </a>
            </div>
            <div class="ow-nav-item">
                <a asp-controller="Owner" asp-action="StockReport"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "StockReport" ? "active" : "")">
                    <i class="bi bi-boxes"></i> Laporan Stok
                </a>
            </div>
            <div class="ow-nav-item">
                <a asp-controller="Owner" asp-action="DamageReport"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "DamageReport" ? "active" : "")">
                    <i class="bi bi-exclamation-triangle"></i> Laporan Kerusakan
                </a>
            </div>
        </nav>
        <div class="mt-auto ow-profile">
            <div class="ow-profile-name">@(User.Identity?.Name ?? "owner")</div>
            <div class="ow-profile-role">Owner</div>
            <div class="ow-profile-actions">
                <a href="/" class="btn btn-sm btn-outline-secondary"><i class="bi bi-globe2 me-1"></i>Website</a>
                <form action="/Auth/Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="ow-main">
        <div class="ow-topbar">
            <h5 class="mb-0 fw-600" style="font-size:0.95rem;">@ViewData["Title"]</h5>
            <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
        </div>
        <div class="ow-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@TempData["Error"]');</text>
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
