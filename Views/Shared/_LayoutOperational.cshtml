@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Operasional</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <style>
        :root {
            --op-bg: #080d18;
            --op-sidebar: #0d1322;
            --op-surface: #131a2a;
            --op-surface2: #192131;
            --op-border: #243049;
            --op-accent: #f59e0b;
            --op-accent2: #3b82f6;
            --op-text: #f8fafc;
            --op-muted: #8294ba;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--op-bg); color: var(--op-text); margin: 0; min-height: 100vh; }
        .op-shell { display: flex; min-height: 100vh; }
        .op-sidebar { width: 300px; min-height: 100vh; height: 100vh; position: sticky; top: 0; background: var(--op-sidebar); border-right: 1px solid var(--op-border); display: flex; flex-direction: column; }
        .op-brand { padding: 2rem 1.8rem 1.6rem; border-bottom: 1px solid var(--op-border); }
        .op-brand-title { color: var(--op-accent); font-size: 1.45rem; font-weight: 800; margin: 0; display: flex; gap: .65rem; align-items: center; }
        .op-brand small { color: var(--op-muted); display: block; margin-top: .55rem; }
        .op-nav { padding: 1.25rem 0; flex: 1; overflow-y: auto; }
        .op-nav a { display: flex; align-items: center; gap: .9rem; padding: .9rem 1.8rem; border-left: 4px solid transparent; color: var(--op-muted); text-decoration: none; font-weight: 500; transition: .18s ease; }
        .op-nav a:hover { color: var(--op-text); background: rgba(255,255,255,.035); }
        .op-nav a.active { color: var(--op-accent); border-left-color: var(--op-accent); background: var(--op-surface2); }
        .op-nav i { width: 1.1rem; text-align: center; }
        .op-profile { margin: 1rem 1.25rem 1.5rem; padding: 1rem; border: 1px solid var(--op-border); border-radius: .9rem; background: rgba(255,255,255,.025); }
        .op-profile-name { color: var(--op-text); font-size: .9rem; font-weight: 700; margin-bottom: .15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .op-profile-role { color: var(--op-muted); font-size: .76rem; margin-bottom: .85rem; }
        .op-profile-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
        .op-profile-actions .btn { font-size: .78rem; border-color: #53627d; color: var(--op-muted); }
        .op-profile-actions .btn:hover { color: var(--op-text); border-color: var(--op-accent); }
        .op-main { flex: 1; min-width: 0; }
        .op-topbar { height: 62px; border-bottom: 1px solid var(--op-border); display: flex; align-items: center; justify-content: space-between; padding: 0 1.85rem; background: rgba(13,19,34,.75); position: sticky; top: 0; z-index: 20; backdrop-filter: blur(14px); }
        .op-topbar h1 { font-size: 1.25rem; font-weight: 800; margin: 0; }
        .op-date { color: var(--op-muted); font-size: .9rem; }
        .op-content { padding: 1.85rem; max-width: none; margin: 0; }
        .op-card { background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 16px; padding: 1.5rem; color: var(--op-text); }
        .op-badge-status { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
        .op-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: 1px solid transparent; transition: all 0.2s; text-decoration: none; }
        .op-btn-primary { background: var(--op-accent); border-color: var(--op-accent); color: #111827; font-weight: 700; }
        .op-btn-primary:hover { background: #d97706; border-color: #d97706; color: #111827; }
        .op-btn-secondary { background: transparent; border-color: #53627d; color: var(--op-muted); }
        .op-btn-secondary:hover { background: var(--op-surface2); color: var(--op-text); border-color: var(--op-accent); }
        .op-btn-success { background: #22c55e; border-color: #22c55e; color: #07130a; font-weight: 700; }
        .op-btn-success:hover { background: #16a34a; color: #07130a; }
        .op-table { width: 100%; border-collapse: collapse; color: var(--op-text); }
        .op-table th { color: var(--op-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--op-border); padding: 0.75rem; }
        .op-table td { padding: 0.875rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
        .op-table tr:hover td { background: rgba(255,255,255,0.03); }
        .text-muted { color: var(--op-muted) !important; }
        .content-header { margin-bottom: 1.2rem; }
        .content-header .container-fluid { padding-left: 0; padding-right: 0; }
        .content-header h1, .content-header h3 { color: var(--op-text) !important; font-weight: 800; }
        .card { background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 16px; color: var(--op-text); box-shadow: none !important; }
        .card-header, .card-footer { background: transparent !important; border-color: var(--op-border) !important; color: var(--op-text); }
        .card-title, .form-label, label, .fw-bold, .fw-semibold, .text-dark { color: var(--op-text) !important; }
        .text-secondary, .form-text { color: var(--op-muted) !important; }
        .bg-white, .bg-light { background: transparent !important; }
        .table { --bs-table-bg: transparent; --bs-table-color: var(--op-text); --bs-table-hover-bg: rgba(255,255,255,.035); color: var(--op-text); }
        .table thead { color: var(--op-muted) !important; }
        .table td, .table th { border-color: rgba(255,255,255,.065); }
        .form-control, .form-select, .input-group-text { background: #0c1220; border-color: var(--op-border); color: var(--op-text); }
        .form-control:focus, .form-select:focus { background: #0c1220; border-color: var(--op-accent); color: var(--op-text); box-shadow: 0 0 0 .2rem rgba(245,158,11,.15); }
        @@media print { .op-sidebar, .op-topbar, .no-print { display: none !important; } body { background: #fff; color: #000; } .op-card { border: none; padding: 0; } }
        @@media (max-width: 991.98px) {
            .op-shell { display: block; }
            .op-sidebar { width: 100%; height: auto; min-height: auto; position: relative; }
            .op-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .75rem; }
            .op-nav a { border-left: 0; border-radius: .75rem; padding: .75rem; }
            .op-profile { margin: .75rem; }
            .op-content { padding: 1rem; }
            .op-date { display: none; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var userName = User?.Identity?.Name ?? "operator";
        var roleName = (User?.IsInRole("Kasir") ?? false) ? "Kasir" : (User?.IsInRole("Kitchen") ?? false) ? "Dapur" : (User?.IsInRole("Supervisor") ?? false) ? "Supervisor" : "Operasional";
    }
    <div class="op-shell">
        <aside class="op-sidebar">
            <div class="op-brand">
                <h1 class="op-brand-title"><i class="bi bi-shop"></i> RESTO PRO</h1>
                <small>@userName</small>
            </div>

            <nav class="op-nav">
                @if ((User?.IsInRole("Kasir") ?? false) || (User?.IsInRole("Admin") ?? false))
                {
                    <a asp-controller="Cashier" asp-action="Index" class="@(controller == "Cashier" ? "active" : "")"><i class="bi bi-receipt"></i>Kasir</a>
                }
                @if ((User?.IsInRole("Kitchen") ?? false) || (User?.IsInRole("Admin") ?? false))
                {
                    <a asp-controller="Kitchen" asp-action="Index" class="@(controller == "Kitchen" ? "active" : "")"><i class="bi bi-fire"></i>Dapur</a>
                }
                @if ((User?.IsInRole("Supervisor") ?? false) || (User?.IsInRole("Admin") ?? false))
                {
                    <a asp-controller="Supervisor" asp-action="Index" class="@(controller == "Supervisor" ? "active" : "")"><i class="bi bi-clipboard-check"></i>Supervisor</a>
                    <a asp-controller="Products" asp-action="Index" class="@(controller == "Products" ? "active" : "")"><i class="bi bi-egg-fried"></i>Data Menu</a>
                    <a asp-controller="Ingredient" asp-action="Index" class="@(controller == "Ingredient" ? "active" : "")"><i class="bi bi-basket"></i>Bahan Mentah</a>
                    <a asp-controller="Inventory" asp-action="Index" class="@(controller == "Inventory" ? "active" : "")"><i class="bi bi-box-seam"></i>Inventaris</a>
                    <a asp-controller="DamageReport" asp-action="Index" class="@(controller == "DamageReport" ? "active" : "")"><i class="bi bi-exclamation-triangle"></i>Laporan Kerusakan</a>
                }
                @if (User?.IsInRole("Admin") ?? false)
                {
                    <a asp-controller="Admin" asp-action="Index" class="@(controller == "Admin" ? "active" : "")"><i class="bi bi-speedometer2"></i>Admin</a>
                }
            </nav>

            <div class="op-profile">
                <div class="op-profile-name">@userName</div>
                <div class="op-profile-role">@roleName</div>
                <div class="op-profile-actions">
                    <a href="/" class="btn btn-sm btn-outline-secondary"><i class="bi bi-globe2 me-1"></i>Website</a>
                    <form action="/Auth/Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="op-main">
            <header class="op-topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="op-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
            </header>
            <div class="op-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            timeOut: 15000,
            extendedTimeOut: 1500,
            positionClass: 'toast-top-right'
        };

        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@TempData["Error"]');</text>
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
