<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/admin-custom.css" />
    <style>
        :root {
            --dash-bg: #080d18;
            --dash-sidebar: #0d1322;
            --dash-surface: #131a2a;
            --dash-surface-2: #192131;
            --dash-border: #243049;
            --dash-text: #f8fafc;
            --dash-muted: #8294ba;
            --dash-accent: #f59e0b;
            --dash-blue: #3b82f6;
            --dash-green: #22c55e;
            --dash-red: #ef4444;
        }

        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; font-family: 'Inter', sans-serif; background: var(--dash-bg); color: var(--dash-text); }
        a { color: inherit; }
        .dashboard-shell { display: flex; min-height: 100vh; }
        .dashboard-sidebar { width: 300px; min-height: 100vh; background: var(--dash-sidebar); border-right: 1px solid var(--dash-border); display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; }
        .dashboard-brand { padding: 2rem 1.8rem 1.6rem; border-bottom: 1px solid var(--dash-border); }
        .dashboard-brand-title { color: var(--dash-accent); font-size: 1.45rem; font-weight: 800; letter-spacing: .01em; margin: 0; display: flex; align-items: center; gap: .65rem; }
        .dashboard-brand-user { color: var(--dash-muted); font-size: .9rem; margin-top: .55rem; }
        .dashboard-nav { padding: 1.25rem 0; flex: 1; overflow-y: auto; }
        .dashboard-nav-label { color: #5d6f94; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 1rem 1.8rem .45rem; }
        .dashboard-nav-link { display: flex; align-items: center; gap: .9rem; padding: .9rem 1.8rem; color: var(--dash-muted); text-decoration: none; font-weight: 500; border-left: 4px solid transparent; transition: .18s ease; }
        .dashboard-nav-link:hover { color: var(--dash-text); background: rgba(255,255,255,.035); }
        .dashboard-nav-link.active { color: var(--dash-accent); background: var(--dash-surface-2); border-left-color: var(--dash-accent); }
        .dashboard-nav-link i { width: 1.1rem; text-align: center; }
        .dashboard-profile { margin: 1rem 1.25rem 1.5rem; padding: 1rem; border: 1px solid var(--dash-border); border-radius: .9rem; background: rgba(255,255,255,.025); }
        .dashboard-profile-name { color: var(--dash-text); font-size: .9rem; font-weight: 700; margin-bottom: .15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .dashboard-profile-role { color: var(--dash-muted); font-size: .76rem; margin-bottom: .85rem; }
        .dashboard-profile-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
        .dashboard-profile-actions .btn { font-size: .78rem; border-color: #53627d; color: var(--dash-muted); }
        .dashboard-profile-actions .btn:hover { color: var(--dash-text); border-color: var(--dash-accent); }
        .dashboard-main { flex: 1; min-width: 0; }
        .dashboard-topbar { height: 62px; border-bottom: 1px solid var(--dash-border); display: flex; align-items: center; justify-content: space-between; padding: 0 1.85rem; background: rgba(13,19,34,.75); position: sticky; top: 0; z-index: 20; backdrop-filter: blur(14px); }
        .dashboard-title { font-size: 1.25rem; font-weight: 800; margin: 0; }
        .dashboard-date { color: var(--dash-muted); font-size: .9rem; }
        .dashboard-content { padding: 1.85rem; }

        .content-header, .app-content-header { margin-bottom: 1.2rem; }
        .content-header .container-fluid, .app-content-header .container-fluid, .app-content .container-fluid { padding-left: 0; padding-right: 0; }
        .content-header h1, .content-header h3, .app-content-header h1, .app-content-header h3 { color: var(--dash-text) !important; font-weight: 800; }
        .breadcrumb, .card-footer nav, .pagination { display: none !important; }
        .card { background: var(--dash-surface); border: 1px solid var(--dash-border); border-radius: 1rem; color: var(--dash-text); box-shadow: none !important; }
        .card-header, .card-footer { background: transparent !important; border-color: var(--dash-border) !important; color: var(--dash-text); }
        .card-title, .form-label, label, .fw-bold, .fw-semibold, .text-dark { color: var(--dash-text) !important; }
        .text-muted, .text-secondary, .form-text { color: var(--dash-muted) !important; }
        .bg-white, .bg-light { background: transparent !important; }
        .table { --bs-table-bg: transparent; --bs-table-color: var(--dash-text); --bs-table-hover-bg: rgba(255,255,255,.035); color: var(--dash-text); }
        .table thead { color: var(--dash-muted) !important; }
        .table td, .table th { border-color: rgba(255,255,255,.065); }
        .form-control, .form-select, .input-group-text { background: #0c1220; border-color: var(--dash-border); color: var(--dash-text); }
        .form-control:focus, .form-select:focus { background: #0c1220; border-color: var(--dash-accent); color: var(--dash-text); box-shadow: 0 0 0 .2rem rgba(245,158,11,.15); }
        .btn-primary { background: var(--dash-accent); border-color: var(--dash-accent); color: #111827; font-weight: 700; }
        .btn-primary:hover { background: #d97706; border-color: #d97706; color: #111827; }
        .btn-outline-secondary, .btn-outline-warning, .btn-outline-danger { border-color: #53627d; color: var(--dash-muted); }
        .btn-outline-secondary:hover, .btn-outline-warning:hover, .btn-outline-danger:hover { background: var(--dash-surface-2); color: var(--dash-text); border-color: var(--dash-accent); }
        .small-box { border-radius: 1rem; border: 1px solid var(--dash-border); background: var(--dash-surface) !important; color: var(--dash-text) !important; padding: 1.2rem; min-height: 150px; }
        .small-box-footer { display: none; }

        @@media (max-width: 991.98px) {
            .dashboard-shell { display: block; }
            .dashboard-sidebar { width: 100%; height: auto; min-height: auto; position: relative; }
            .dashboard-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .75rem; }
            .dashboard-nav-label { display: none; }
            .dashboard-nav-link { border-left: 0; border-radius: .75rem; padding: .75rem; }
            .dashboard-profile { margin: .75rem; }
            .dashboard-content { padding: 1rem; }
            .dashboard-date { display: none; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var userName = User?.Identity?.Name ?? "admin";
    }
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <div class="dashboard-brand">
                <h1 class="dashboard-brand-title"><i class="bi bi-graph-up-arrow"></i> ADMIN</h1>
                <div class="dashboard-brand-user">@userName</div>
            </div>

            <nav class="dashboard-nav">
                <a asp-controller="Admin" asp-action="Index" class="dashboard-nav-link @(controller == "Admin" ? "active" : "")"><i class="bi bi-speedometer2"></i>Dashboard</a>
                <div class="dashboard-nav-label">Master Data</div>
                <a asp-controller="Products" asp-action="Index" class="dashboard-nav-link @(controller == "Products" ? "active" : "")"><i class="bi bi-egg-fried"></i>Manajemen Menu</a>
                <a asp-controller="Table" asp-action="Index" class="dashboard-nav-link @(controller == "Table" ? "active" : "")"><i class="bi bi-grid-3x3-gap"></i>Manajemen Meja</a>
                <a asp-controller="User" asp-action="Index" class="dashboard-nav-link @(controller == "User" ? "active" : "")"><i class="bi bi-people"></i>Manajemen User</a>
                <a asp-controller="Ingredient" asp-action="Index" class="dashboard-nav-link @(controller == "Ingredient" ? "active" : "")"><i class="bi bi-basket"></i>Manajemen Bahan</a>
                <a asp-controller="Inventory" asp-action="Index" class="dashboard-nav-link @(controller == "Inventory" ? "active" : "")"><i class="bi bi-box-seam"></i>Manajemen Inventory</a>
                <div class="dashboard-nav-label">Operasional</div>
                <a asp-controller="Cashier" asp-action="Index" class="dashboard-nav-link @(controller == "Cashier" ? "active" : "")"><i class="bi bi-receipt"></i>Kasir</a>
                <a asp-controller="Kitchen" asp-action="Index" class="dashboard-nav-link @(controller == "Kitchen" ? "active" : "")"><i class="bi bi-fire"></i>Dapur</a>
                <a asp-controller="Supervisor" asp-action="Index" class="dashboard-nav-link @(controller == "Supervisor" ? "active" : "")"><i class="bi bi-clipboard-check"></i>Supervisor</a>
                <a asp-controller="DamageReport" asp-action="Index" class="dashboard-nav-link @(controller == "DamageReport" ? "active" : "")"><i class="bi bi-exclamation-triangle"></i>Laporan Kerusakan</a>
                <a asp-controller="Owner" asp-action="Dashboard" class="dashboard-nav-link @(controller == "Owner" ? "active" : "")"><i class="bi bi-bar-chart-line"></i>Owner</a>
            </nav>

            <div class="dashboard-profile">
                <div class="dashboard-profile-name">@userName</div>
                <div class="dashboard-profile-role">Administrator</div>
                <div class="dashboard-profile-actions">
                    <a href="/" class="btn btn-sm btn-outline-secondary"><i class="bi bi-globe2 me-1"></i>Website</a>
                    <form action="/Auth/Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="dashboard-main">
            <header class="dashboard-topbar">
                <h2 class="dashboard-title">@ViewData["Title"]</h2>
                <div class="dashboard-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
            </header>
            <section class="dashboard-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@TempData["Error"]');</text>
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
