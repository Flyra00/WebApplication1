@using Microsoft.Extensions.Options
@using WebApplication1.Configuration
@inject IOptions<PublicSiteOptions> PublicSiteOptionsAccessor
@{
    var site = PublicSiteOptionsAccessor.Value;
    var tableToken = Context.Request.Cookies["nr_tableToken"] ?? string.Empty;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <partial name="_PublicHead" />
    <meta name="table-token" content="@tableToken" />
    <title>@ViewData["Title"] - @site.BrandName</title>
    <style>
        :root {
            --surface: #fcf9f8;
            --surface-lowest: #ffffff;
            --surface-low: #f6f3f2;
            --surface-container: #f0eded;
            --warm-beige: #f4ede3;
            --on-surface: #1c1b1b;
            --on-surface-variant: #584238;
            --outline-variant: #e0c0b2;
            --terracotta: #9c3f00;
            --terracotta-dark: #7a3000;
            --forest: #5e604d;
        }

        html { scroll-behavior: smooth; }
        body {
            min-height: 100dvh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(224, 122, 95, .14), transparent 32rem),
                linear-gradient(180deg, #fff8f2 0%, var(--surface) 36%, #fbf6f2 100%);
            color: var(--on-surface);
            font-family: 'Inter', sans-serif;
        }
        a { color: inherit; text-decoration: none; }
        button, input { font: inherit; }
        button { cursor: pointer; border: 0; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .page-shell { width: min(100% - 48px, 1180px); margin: 0 auto; }
        .site-header {
            position: sticky;
            top: 0;
            z-index: 30;
            border-bottom: 1px solid rgba(219, 193, 186, .65);
            background: rgba(244, 237, 227, .88);
            backdrop-filter: blur(16px);
        }
        .site-nav {
            min-height: 88px;
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: 22px;
        }
        .brand { display: inline-flex; align-items: center; gap: 14px; min-width: 0; }
        .brand-mark {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--surface-lowest);
            color: var(--terracotta);
            box-shadow: inset 0 0 0 1px rgba(219, 193, 186, .52);
        }
        .brand-text { display: grid; gap: 2px; }
        .brand-name {
            color: var(--terracotta-dark);
            font-family: 'Noto Serif', serif;
            font-size: 22px;
            font-weight: 700;
            line-height: 1;
        }
        .brand-subtitle {
            color: var(--on-surface-variant);
            font-size: 11px;
            letter-spacing: .14em;
            text-transform: uppercase;
        }
        .brand-text,
        .account-copy {
            min-width: 0;
        }
        .nav-links {
            display: flex;
            align-items: center;
            justify-self: center;
            gap: 8px;
            min-width: 0;
            padding: 8px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .66);
            border: 1px solid rgba(219, 193, 186, .7);
            box-shadow: 0 12px 30px rgba(44, 44, 44, .05);
        }
        .nav-links a:hover,
        .nav-link-button:hover { color: var(--terracotta-dark); }
        .nav-link-chip {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 14px;
            border-radius: 999px;
            color: var(--on-surface-variant);
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
            transition: background .18s ease, color .18s ease, transform .18s ease;
        }
        .nav-link-chip:hover {
            background: rgba(156, 63, 0, .08);
            color: var(--terracotta-dark);
            transform: translateY(-1px);
        }
        .nav-link-button {
            background: transparent;
            color: inherit;
            font: inherit;
            font-weight: 700;
        }
        .nav-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            min-width: 0;
        }
        .account-link,
        .table-pill, .outline-link, .primary-link {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 999px;
            padding: 0 18px;
            font-weight: 700;
        }
        .account-link {
            max-width: 210px;
            background: rgba(255, 255, 255, .78);
            color: var(--on-surface);
            border: 1px solid rgba(219, 193, 186, .72);
            box-shadow: 0 10px 26px rgba(44, 44, 44, .05);
        }
        .account-copy {
            display: grid;
            gap: 1px;
            text-align: left;
        }
        .account-label,
        .account-meta {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .account-label {
            font-size: 13px;
        }
        .account-meta {
            color: var(--on-surface-variant);
            font-size: 11px;
            font-weight: 600;
        }
        .table-pill {
            background: var(--surface-lowest);
            color: var(--terracotta);
            border: 1px solid var(--outline-variant);
        }
        .outline-link {
            background: transparent;
            color: var(--forest);
            border: 1px solid rgba(72, 102, 72, .45);
        }
        .primary-link {
            background: var(--terracotta);
            color: #fff;
        }
        .cart-trigger {
            position: relative;
            width: 44px;
            height: 44px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            color: var(--terracotta);
            background: var(--surface-lowest);
            border: 1px solid var(--outline-variant);
        }
        .cart-trigger-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            background: var(--terracotta);
            color: #fff;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
            font-size: 11px;
            font-weight: 700;
        }
        .cart-trigger-badge.visible { display: inline-flex; }
        .site-footer {
            border-top: 1px solid rgba(219, 193, 186, .68);
            background:
                radial-gradient(circle at top right, rgba(94, 96, 77, .08), transparent 22rem),
                linear-gradient(180deg, rgba(244, 237, 227, .92), rgba(252, 249, 248, .98));
            color: var(--on-surface-variant);
        }
        .footer-shell {
            padding: 38px 0 22px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr));
            gap: 22px;
        }
        .footer-brand-card,
        .footer-block {
            display: grid;
            gap: 12px;
            padding: 22px;
            border-radius: 24px;
            background: rgba(255, 255, 255, .72);
            border: 1px solid rgba(219, 193, 186, .72);
            box-shadow: 0 14px 40px rgba(44, 44, 44, .05);
        }
        .footer-brand-card p,
        .footer-block p {
            margin: 0;
            line-height: 1.7;
        }
        .footer-kicker {
            color: var(--forest);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }
        .footer-heading {
            margin: 0;
            color: var(--on-surface);
            font-family: 'Noto Serif', serif;
            font-size: 22px;
            line-height: 1.15;
        }
        .footer-copy {
            color: var(--on-surface-variant);
        }
        .footer-list {
            display: grid;
            gap: 10px;
        }
        .footer-link,
        .footer-contact-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--on-surface);
            line-height: 1.5;
        }
        .footer-link:hover,
        .footer-contact-link:hover {
            color: var(--terracotta-dark);
        }
        .footer-socials {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .footer-social-link {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(156, 63, 0, .08);
            color: var(--terracotta-dark);
            border: 1px solid rgba(156, 63, 0, .12);
            font-weight: 700;
        }
        .footer-social-link:hover {
            background: rgba(156, 63, 0, .14);
        }
        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid rgba(219, 193, 186, .68);
            font-size: 14px;
        }
        .public-toast-container {
            position: fixed;
            top: 92px;
            right: 24px;
            z-index: 9999;
            display: grid;
            gap: 12px;
            width: min(92vw, 360px);
        }
        .public-toast {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 16px;
            border-radius: 18px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(224,192,178,.85);
            box-shadow: 0 18px 40px rgba(44,44,44,.12);
            color: var(--on-surface);
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity .2s ease, transform .2s ease;
        }
        .public-toast.show { opacity: 1; transform: translateY(0); }
        .public-toast-icon {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }
        .public-toast-success .public-toast-icon { background: rgba(47,111,72,.12); color: #2f6f48; }
        .public-toast-error .public-toast-icon { background: rgba(186,26,26,.1); color: #ba1a1a; }
        .public-toast-info .public-toast-icon { background: rgba(156,63,0,.1); color: var(--terracotta); }
        .public-toast-message { line-height: 1.5; font-weight: 600; }

        @@media (max-width: 960px) {
            .site-nav {
                min-height: auto;
                grid-template-columns: 1fr;
                justify-items: stretch;
                padding: 16px 0 18px;
            }
            .nav-links,
            .nav-actions,
            .brand {
                width: 100%;
            }
            .nav-links {
                justify-self: stretch;
                justify-content: flex-start;
                overflow-x: auto;
            }
            .nav-actions {
                flex-wrap: wrap;
                justify-content: flex-start;
            }
            .footer-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 760px) {
            .page-shell { width: min(100% - 32px, 1180px); }
            .brand-subtitle { display: none; }
            .site-header {
                background: rgba(244, 237, 227, .95);
            }
            .site-nav {
                gap: 14px;
            }
            .nav-links {
                gap: 6px;
                padding: 6px;
            }
            .nav-link-chip {
                min-height: 36px;
                padding: 0 12px;
                font-size: 13px;
            }
            .account-link,
            .table-pill, .outline-link, .primary-link { min-height: 40px; padding: 0 13px; font-size: 13px; }
            .account-link {
                max-width: 100%;
            }
            .nav-actions > * {
                flex: 0 0 auto;
            }
            .cart-trigger { width: 40px; height: 40px; }
            .footer-shell { padding: 28px 0 18px; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom {
                align-items: start;
                flex-direction: column;
            }
            .public-toast-container { top: 82px; right: 16px; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <partial name="_PublicNavbar" />
    <div class="public-toast-container" id="publicToastContainer"></div>
    @RenderBody()
    <partial name="_PublicFooter" />
    <script>
        window.showPublicToast = function (message, type) {
            const container = document.getElementById('publicToastContainer');
            if (!container || !message) return;

            const resolvedType = type === 'success' || type === 'error' ? type : 'info';
            const icon = resolvedType === 'success' ? 'check_circle' : resolvedType === 'error' ? 'error' : 'info';

            const toast = document.createElement('div');
            toast.className = 'public-toast public-toast-' + resolvedType;
            toast.innerHTML = '<div class="public-toast-icon"><span class="material-symbols-outlined" style="font-size:18px;">' + icon + '</span></div><div class="public-toast-message"></div>';
            toast.querySelector('.public-toast-message').textContent = message;
            container.appendChild(toast);

            requestAnimationFrame(function () { toast.classList.add('show'); });
            window.setTimeout(function () {
                toast.classList.remove('show');
                window.setTimeout(function () { toast.remove(); }, 250);
            }, 4500);
        };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
