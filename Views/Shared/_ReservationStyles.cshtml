    .reservation-choice-card.active {
        border-color: rgba(156, 63, 0, .32);
        background: linear-gradient(180deg, rgba(244, 237, 227, .95), #fff);
        box-shadow: 0 14px 32px rgba(156, 63, 0, .08);
