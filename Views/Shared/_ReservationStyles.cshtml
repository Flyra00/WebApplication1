    body[data-theme="dark"] .reservation-control:focus,
    body[data-theme="dark"] .reservation-select:focus,
    body[data-theme="dark"] .reservation-textarea:focus {
        border-color: var(--terracotta);
        background: #0d1220;
    }
    :root {
        --surface: #fcf9f8;
        --surface-lowest: #ffffff;
        --surface-low: #f6f3f2;
        --surface-container: #f0eded;
        --on-surface: #1c1b1b;
        --on-surface-variant: #584238;
        --outline: #8c7166;
        --outline-variant: #e0c0b2;
        --terracotta: #9c3f00;
