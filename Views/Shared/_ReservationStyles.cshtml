        background: rgba(47, 111, 72, .1);
        border-color: rgba(47, 111, 72, .2);
        color: #2f6f48;
    }

    .reservation-alert-warning {
        background: rgba(245, 158, 11, .1);
        border-color: rgba(245, 158, 11, .2);
        color: #b45309;
    }

    .reservation-alert-error {
