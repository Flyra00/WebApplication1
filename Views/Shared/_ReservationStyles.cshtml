    .reservation-choice-kicker {
        color: var(--forest);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .reservation-choice-title {
        margin: 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 20px;
        line-height: 1.15;
    }

    .reservation-choice-desc {
        margin: 0;
        color: var(--on-surface-variant);
        line-height: 1.65;
    }

    .reservation-choice-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .reservation-step-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .reservation-step-card {
        display: grid;
        gap: 10px;
        padding: 18px;
        border-radius: 18px;
        border: 1px solid rgba(219, 193, 186, .55);
        background: var(--surface-low);
    }

    .reservation-step-number {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(156, 63, 0, .1);
        color: var(--terracotta);
        font-weight: 800;
    }

    .reservation-step-title {
        margin: 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 18px;
        line-height: 1.2;
    }

    .reservation-step-desc {
        margin: 0;
        color: var(--on-surface-variant);
        line-height: 1.6;
    }

    .reservation-sidebar {
        display: grid;
        gap: 20px;
    }

    .reservation-help-list {
        display: grid;
        gap: 12px;
