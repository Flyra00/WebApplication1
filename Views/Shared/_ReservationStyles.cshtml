<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Serif:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<style>
    /* Reservation content needs extra top clearance so the sticky public navbar
       does not cover the first card on entry. */
    .reservation-page.page-shell {
        padding-top: 80px;
    }
    /* Honour homepage CSS custom-property colour tokens so the cards look
       correct in both light and dark themes toggled by web.js */
    body[data-theme="dark"] {
        --surface: #1a1f2e;
        --surface-lowest: #131929;
        --surface-low: #1e2538;
        --surface-container: #252c3c;
        --on-surface: #f0ece9;
        --on-surface-variant: #bdb3aa;
        --outline: #7a6a60;
        --outline-variant: #4a3832;
