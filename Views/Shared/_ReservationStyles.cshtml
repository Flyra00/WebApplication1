    .reservation-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr);
        gap: 24px;
        align-items: start;
    }

    .reservation-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .reservation-badge-terracotta { background: rgba(156, 63, 0, .1); color: var(--terracotta); border: 1px solid rgba(156, 63, 0, .18); }
    .reservation-badge-success { background: rgba(47, 111, 72, .1); color: var(--success); border: 1px solid rgba(47, 111, 72, .18); }
    .reservation-badge-muted { background: rgba(88, 66, 56, .08); color: var(--on-surface-variant); border: 1px solid rgba(88, 66, 56, .12); }
    .reservation-status-pending { background: rgba(245, 158, 11, .12); color: #b45309; border: 1px solid rgba(245, 158, 11, .18); }
    .reservation-status-confirmed { background: rgba(156, 63, 0, .1); color: var(--terracotta); border: 1px solid rgba(156, 63, 0, .18); }
    .reservation-status-checkedin { background: rgba(47, 111, 72, .1); color: var(--success); border: 1px solid rgba(47, 111, 72, .18); }
    .reservation-status-completed { background: rgba(88, 66, 56, .1); color: var(--on-surface-variant); border: 1px solid rgba(88, 66, 56, .14); }
    .reservation-status-rejected,
    .reservation-status-cancelled { background: rgba(186, 26, 26, .1); color: var(--error); border: 1px solid rgba(186, 26, 26, .18); }
    .reservation-status-noshow { background: rgba(2, 132, 199, .1); color: #0369a1; border: 1px solid rgba(2, 132, 199, .18); }

    .reservation-code {
        margin: 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: clamp(26px, 4vw, 40px);
        line-height: 1.05;
        color: var(--terracotta);
        word-break: break-word;
    }

    .reservation-kv {
        display: grid;
        gap: 14px;
    }

    .reservation-kv-item {
        display: grid;
        gap: 4px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(219, 193, 186, .5);
    }

    .reservation-kv-item:last-child { padding-bottom: 0; border-bottom: 0; }
    .reservation-kv-label {
        color: var(--on-surface-variant);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .reservation-kv-value {
        color: var(--on-surface);
        line-height: 1.65;
        font-weight: 600;
    }

    .reservation-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .reservation-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(219, 193, 186, .55);
        background: rgba(255, 255, 255, .72);
        color: var(--on-surface-variant);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .03em;
    }

    .reservation-stat {
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px solid rgba(219, 193, 186, .5);
        background: var(--surface-low);
    }

    .reservation-duration-card {
        min-height: 52px;
        display: grid;
        align-content: center;
    }

    .reservation-duration-meta {
        display: grid;
        gap: 3px;
    }

    .reservation-duration-label {
        margin: 0;
        color: var(--on-surface-variant);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .09em;
        text-transform: uppercase;
    }

    .reservation-duration-value {
        margin: 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--terracotta);
        line-height: 1.15;
    }

    .reservation-stat-label {
        margin: 0;
        color: var(--on-surface-variant);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .09em;
        text-transform: uppercase;
    }

    .reservation-stat-value {
        margin-top: 6px;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.1;
        color: var(--on-surface);
    }

    .reservation-table-wrap {
        overflow-x: auto;
        border-radius: 20px;
        border: 1px solid rgba(219, 193, 186, .6);
        background: var(--surface-lowest);
    }

    .reservation-table {
        width: 100%;
        min-width: 920px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
        color: var(--on-surface);
    }

    .reservation-table thead th {
        background: var(--surface-low);
        color: var(--on-surface-variant);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(219, 193, 186, .5);
        white-space: nowrap;
    }

    .reservation-table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid rgba(219, 193, 186, .4);
    }

    .reservation-table tbody tr:last-child td { border-bottom: 0; }
    .reservation-table tbody tr:hover td { background: rgba(156, 63, 0, .03); }
    .reservation-table-meta { display: grid; gap: 3px; }
    .reservation-table-code { color: var(--terracotta); font-family: 'Noto Serif', Georgia, serif; font-weight: 700; }
    .reservation-action-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
    .reservation-inline-btn { min-height: 42px; padding: 0 14px; border-radius: 10px; font-weight: 800; }
    .reservation-empty {
        padding: 42px 20px;
        text-align: center;
        color: var(--on-surface-variant);
    }

    .reservation-lookup-panel {
        display: grid;
        gap: 16px;
    }

    .reservation-lookup-actions {
        display: grid;
        gap: 10px;
    }

    @@media (max-width: 576px) {
        .reservation-page { padding: 24px 0 48px; }
        .reservation-page.page-shell { padding-top: 84px; }
        .reservation-card-body { padding: 20px; }
        .reservation-grid-2,
        .reservation-grid-3,
        .reservation-statgrid,
        .reservation-hero,
        .reservation-layout { grid-template-columns: 1fr; }
        .reservation-choice-grid,
        .reservation-step-grid { grid-template-columns: 1fr; }
        .reservation-actions,
        .reservation-action-list { justify-content: stretch; }
        .reservation-btn,
        .reservation-inline-btn { width: 100%; }
        .reservation-table { min-width: 760px; }
        .reservation-section-title { font-size: 20px; }
        .reservation-chip-row { gap: 8px; }
        .reservation-chip { width: 100%; justify-content: center; }
    }

    /* ── Pay option cards ────────────────────────────────────────────────────── */
    .pay-option-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-top: 4px;
    }
    .pay-option-card {
        position: relative;
        border-radius: 20px;
        border: 2px solid rgba(140, 113, 102, .2);
        background: var(--surface-lowest);
        padding: 24px 20px;
        cursor: pointer;
        transition: border-color .2s, box-shadow .2s, transform .15s;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .pay-option-card:hover {
        border-color: var(--terracotta);
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(156, 63, 0, .12);
    }
    .pay-option-card.selected {
        border-color: var(--terracotta);
        background: rgba(156, 63, 0, .04);
        box-shadow: 0 0 0 4px rgba(156, 63, 0, .08);
    }
    .pay-option-card input[type=radio] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }
    .pay-option-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(156, 63, 0, .08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--terracotta);
        font-size: 22px;
    }
    .pay-option-title {
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 16px;
        font-weight: 700;
        color: var(--on-surface);
        margin: 0;
    }
    .pay-option-desc {
        font-size: 13px;
        color: var(--on-surface-variant);
        margin: 0;
        line-height: 1.6;
    }
    .pay-option-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .05em;
        background: rgba(156, 63, 0, .1);
        color: var(--terracotta);
        border: 1px solid rgba(156, 63, 0, .18);
        width: fit-content;
    }
    .pay-dp-info {
        border-radius: 16px;
        border: 1px solid rgba(156, 63, 0, .14);
        background: rgba(244, 237, 227, .65);
        padding: 14px 16px;
        font-size: 14px;
        color: var(--on-surface-variant);
        line-height: 1.65;
        display: none;
    }
    .pay-dp-info.active { display: block; }
    .pay-amount-display {
        font-family: 'Noto Serif', Georgia, serif;
        font-size: clamp(26px, 4vw, 38px);
        font-weight: 700;
        color: var(--terracotta);
        margin: 0;
    }
    .pay-amount-label {
        font-size: 13px;
        color: var(--on-surface-variant);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin: 0;
    }
    .midtrans-snap-container { min-height: 480px; }
    body[data-theme="dark"] .pay-option-card {
        background: #131929;
        border-color: rgba(90, 72, 62, .35);
    }
    body[data-theme="dark"] .pay-dp-info {
        background: rgba(30, 22, 18, .7);
        border-color: rgba(156, 63, 0, .2);
    }
</style>
