        border-color: rgba(186, 26, 26, .18);
        color: #ba1a1a;
    }

    .reservation-alert-icon {
        font-size: 20px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .reservation-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
        align-items: center;
    }

    .reservation-btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 12px;
        padding: 0 20px;
        font-weight: 800;
        border: 1px solid transparent;
        text-decoration: none;
    }

    .reservation-btn-primary {
        background: var(--terracotta);
        color: #fff;
        border-color: var(--terracotta);
    }

