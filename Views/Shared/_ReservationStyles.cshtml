        gap: 16px;
    }

    .reservation-section + .reservation-section {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid rgba(219, 193, 186, .5);
    }

    .reservation-section-title {
        margin: 0;
        font-family: 'Noto Serif', Georgia, serif;
        font-size: 22px;
        line-height: 1.15;
    }

    .reservation-section-subtitle {
        margin: 0;
        color: var(--on-surface-variant);
        line-height: 1.65;
