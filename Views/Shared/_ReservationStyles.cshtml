        display: grid;
        gap: 14px;
    }

    .reservation-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reservation-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .reservation-statgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .reservation-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .reservation-label {
        margin: 0;
        color: var(--on-surface-variant);
        font-size: 14px;
        font-weight: 700;
    }

    .reservation-control,
    .reservation-select,
    .reservation-textarea {
        min-height: 52px;
        border-radius: 14px;
        border: 1px solid rgba(140, 113, 102, .22);
        background: #fff;
        color: var(--on-surface);
        box-shadow: none;
        padding: .9rem 1rem;
    }

    .reservation-textarea { min-height: 122px; resize: vertical; }

    .reservation-control:focus,
    .reservation-select:focus,
    .reservation-textarea:focus {
        border-color: var(--terracotta);
        box-shadow: 0 0 0 .2rem rgba(156, 63, 0, .12);
    }

    .reservation-alert {
        border-radius: 18px;
        border: 1px solid rgba(156, 63, 0, .16);
        background: rgba(244, 237, 227, .65);
        color: var(--on-surface-variant);
        padding: 14px 16px;
        line-height: 1.6;
