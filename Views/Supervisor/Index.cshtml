@{
    ViewData["Title"] = "Dashboard Supervisor";
    Layout = "~/Views/Shared/_LayoutOperational.cshtml";
    var lowIngredients  = ViewBag.LowIngredients  as List<WebApplication1.Models.Ingredient>;
    var recentDamages   = ViewBag.RecentDamages   as List<WebApplication1.Models.DamageReport>;
    var totalIngr       = (int)(ViewBag.TotalIngredients    ?? 0);
    var totalInv        = (int)(ViewBag.TotalInventoryItems ?? 0);
    var todayDmg        = (int)(ViewBag.TodayDamageCount    ?? 0);
    var pendingDmg      = (int)(ViewBag.PendingDamageCount  ?? 0);
    var lowCount        = lowIngredients?.Count ?? 0;
    var reservationPendingToday = (int)(ViewBag.ReservationPendingToday ?? 0);
    var reservationConfirmedToday = (int)(ViewBag.ReservationConfirmedToday ?? 0);
    var reservationCheckedInToday = (int)(ViewBag.ReservationCheckedInToday ?? 0);
    var reservationWithPaidPayment = (int)(ViewBag.ReservationWithPaidPayment ?? 0);
    var reservationPaymentPending = (int)(ViewBag.ReservationPaymentPending ?? 0);
    var reservationUnpaidRemainder = (int)(ViewBag.ReservationUnpaidRemainder ?? 0);
}

<style>
    .sv-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .sv-stat-card { background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 14px; padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: .4rem; }
    .sv-stat-label { color: var(--op-muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; margin: 0; }
    .sv-stat-value { font-size: 2rem; font-weight: 800; line-height: 1.1; margin: 0; }
    .sv-stat-sub   { color: var(--op-muted); font-size: .8rem; margin: 0; }
    .sv-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.5rem; }
    .sv-quick-btn { display: inline-flex; align-items: center; gap: .5rem; padding: .6rem 1.1rem; border-radius: 10px; font-size: .875rem; font-weight: 600; border: 1px solid var(--op-border); background: var(--op-surface); color: var(--op-text); text-decoration: none; transition: .18s; }
    .sv-quick-btn:hover { background: var(--op-surface2); border-color: var(--op-accent); color: var(--op-accent); }
    .sv-quick-btn i { font-size: 1.1rem; }
    .sv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @@media (max-width: 900px) { .sv-grid { grid-template-columns: 1fr; } }
    .sv-urgent-row td:first-child { font-weight: 600; }
    .sv-urgent-qty { color: #ef4444; font-weight: 700; }
    .dmg-item { display: flex; align-items: flex-start; gap: .85rem; padding: .75rem 0; border-bottom: 1px solid var(--op-border); }
    .dmg-item:last-child { border-bottom: none; }
    .dmg-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .dmg-meta { color: var(--op-muted); font-size: .8rem; margin-top: .2rem; }
</style>

@* Header *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Dashboard Supervisor</h4>
        <small style="color:var(--op-muted);">Monitoring operasional harian — @BusinessTime.BusinessNow.ToString("dd MMMM yyyy")</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="DamageReport" asp-action="Create" class="op-btn op-btn-primary">
            <i class="bi bi-exclamation-triangle me-1"></i>Lapor Kerusakan
        </a>
    </div>
</div>

@* Stats Cards *@
<div class="sv-stats">
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-basket me-1"></i>Bahan Dapur</p>
        <p class="sv-stat-value">@totalIngr</p>
        <p class="sv-stat-sub">@lowCount item stok menipis</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-box-seam me-1"></i>Inventaris</p>
        <p class="sv-stat-value">@totalInv</p>
        <p class="sv-stat-sub">Total item terdaftar</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-shield-exclamation me-1"></i>Kerusakan Hari Ini</p>
        <p class="sv-stat-value" style="color:@(todayDmg>0?"#f97316":"#22c55e");">@todayDmg</p>
        <p class="sv-stat-sub">Laporan masuk hari ini</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-clock-history me-1"></i>Laporan Pending</p>
        <p class="sv-stat-value" style="color:@(pendingDmg>0?"#ef4444":"#22c55e");">@pendingDmg</p>
        <p class="sv-stat-sub">Menunggu tindak lanjut</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-calendar-check me-1"></i>Reservasi Pending</p>
        <p class="sv-stat-value">@reservationPendingToday</p>
        <p class="sv-stat-sub">Hari ini</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-check2-circle me-1"></i>Reservasi Confirmed</p>
        <p class="sv-stat-value">@reservationConfirmedToday</p>
        <p class="sv-stat-sub">Hari ini</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-cash-coin me-1"></i>Sudah Bayar</p>
        <p class="sv-stat-value">@reservationWithPaidPayment</p>
        <p class="sv-stat-sub">Sudah ada pembayaran</p>
    </div>
    <div class="sv-stat-card">
        <p class="sv-stat-label"><i class="bi bi-receipt me-1"></i>Sisa Bayar</p>
        <p class="sv-stat-value">@reservationUnpaidRemainder</p>
        <p class="sv-stat-sub">Menunggu pelunasan</p>
    </div>
</div>

@* Quick Actions *@
<div class="sv-actions mb-4">
    <a asp-controller="Ingredient" asp-action="Index" class="sv-quick-btn">
        <i class="bi bi-basket"></i> Kelola Bahan
    </a>
    <a asp-controller="Inventory" asp-action="Index" class="sv-quick-btn">
        <i class="bi bi-box-seam"></i> Kelola Inventaris
    </a>
    <a asp-controller="DamageReport" asp-action="Index" class="sv-quick-btn">
        <i class="bi bi-exclamation-triangle"></i> Semua Laporan Kerusakan
    </a>
    <a asp-controller="Products" asp-action="Index" class="sv-quick-btn">
        <i class="bi bi-egg-fried"></i> Kelola Menu
    </a>
</div>

@* Grid 2 kolom *@
<div class="sv-grid">

    @* Kiri: Stok Bahan Menipis *@
    <div class="op-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-semibold mb-0" style="color:#ef4444;">
                <i class="bi bi-exclamation-circle me-2"></i>Stok Bahan Menipis
            </h6>
            <span class="badge" style="background:#ef444422;color:#ef4444;border:1px solid #ef444455;">
                @lowCount item
            </span>
        </div>

        @if (lowIngredients == null || !lowIngredients.Any())
        {
            <div style="text-align:center;padding:2rem 0;">
                <i class="bi bi-check-circle" style="font-size:2rem;color:#22c55e;"></i>
                <p style="color:var(--op-muted);margin-top:.5rem;font-size:.875rem;">Semua stok bahan dalam kondisi baik ✓</p>
            </div>
        }
        else
        {
            <table class="op-table" style="font-size:.875rem;">
                <thead>
                    <tr>
                        <th>Bahan</th>
                        <th>Satuan</th>
                        <th>Stok</th>
                        <th>Min.</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in lowIngredients)
                    {
                        var isUrgent = i.Qty == 0;
                        <tr class="sv-urgent-row">
                            <td>@i.ItemName</td>
                            <td style="color:var(--op-muted);">@i.Unit</td>
                            <td class="sv-urgent-qty">@i.Qty</td>
                            <td style="color:var(--op-muted);">@i.MinimumStock</td>
                            <td>
                                @if (isUrgent)
                                {
                                    <span class="op-badge-status" style="background:#ef444422;color:#ef4444;border:1px solid #ef444455;font-size:.7rem;">Habis</span>
                                }
                                else
                                {
                                    <span class="op-badge-status" style="background:#f9731622;color:#f97316;border:1px solid #f9731655;font-size:.7rem;">Menipis</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="mt-3">
                <a asp-controller="Ingredient" asp-action="Index" class="op-btn op-btn-secondary" style="font-size:.8rem;">
                    <i class="bi bi-arrow-right me-1"></i>Kelola semua bahan
                </a>
            </div>
        }
    </div>

    @* Kanan: Laporan Kerusakan Terbaru *@
    <div class="op-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-semibold mb-0" style="color:#f97316;">
                <i class="bi bi-shield-exclamation me-2"></i>Laporan Kerusakan Terbaru
            </h6>
            <a asp-controller="DamageReport" asp-action="Index" style="font-size:.8rem;color:var(--op-accent);">
                Lihat semua →
            </a>
        </div>

        @if (recentDamages == null || !recentDamages.Any())
        {
            <div style="text-align:center;padding:2rem 0;">
                <i class="bi bi-check-circle" style="font-size:2rem;color:#22c55e;"></i>
                <p style="color:var(--op-muted);margin-top:.5rem;font-size:.875rem;">Belum ada laporan kerusakan ✓</p>
            </div>
        }
        else
        {
            @foreach (var d in recentDamages)
            {
                var statusColor = d.Status == "Open" ? "#ef4444" : "#22c55e";
                var statusBg    = d.Status == "Open" ? "#ef444422" : "#22c55e22";
                <div class="dmg-item">
                    <div class="dmg-icon" style="background:#f9731620;">
                        <i class="bi bi-shield-exclamation" style="color:#f97316;"></i>
                    </div>
                    <div class="flex-fill">
                        <span class="fw-semibold" style="font-size:.9rem;">@d.InventoryItem?.ItemName</span>
                        <div class="dmg-meta">
                            @d.Qty unit ·
                            @(d.ReportedByUser?.FullName ?? d.ReportedByUser?.UserName ?? "—") ·
                            @BusinessTime.ToBusinessTime(d.ReportDate).ToString("dd/MM HH:mm")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(d.Description))
                        {
                            <div style="color:var(--op-muted);font-size:.8rem;margin-top:2px;">@d.Description</div>
                        }
                    </div>
                    <span class="op-badge-status" style="background:@statusBg;color:@statusColor;border:1px solid @statusColor;font-size:.7rem;white-space:nowrap;">
                        @d.Status
                    </span>
                </div>
            }
            <div class="mt-3">
                <a asp-controller="DamageReport" asp-action="Create" class="op-btn op-btn-primary" style="font-size:.8rem;">
                    <i class="bi bi-plus me-1"></i>Lapor Kerusakan Baru
                </a>
            </div>
        }
    </div>
</div>
