@model List<Inventory>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Barang";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold text-dark"><i class="bi bi-box-seam me-2"></i>Manajemen Barang</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Barang
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold mb-0">Daftar Barang</h3>
                <span class="badge bg-light text-dark border">Total: @Model.Count</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase small fw-bold">
                            <tr>
                                <th class="ps-4">Nama Barang</th>
                                <th>Kategori</th>
                                <th class="text-center">Qty</th>
                                <th>Kondisi</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">Belum ada data Barang.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var inven in Model)
                                {
                                    var qtyClass = inven.Qty switch
                                    {
                                        <= 5 => "bg-danger-subtle text-danger",
                                        <= 15 => "bg-warning-subtle text-warning",
                                        _ => "bg-success-subtle text-success"
                                    };

                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@inven.ItemName</td>
                                        @{
                                            var badgeClass = inven.Condition switch
                                            {
                                                "Bagus" => "bg-primary-subtle text-primary",
                                                "Rusak" => "bg-success-subtle text-success",
                                                "Perbaikan" => "bg-warning-subtle text-warning",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass border border-opacity-25 rounded-pill px-2" style="font-size: 0.75rem;">
                                            @inven.Condition
                                        </span>
                                        <td>@inven.Category</td>
                                        <td class="text-center"><span class="badge @qtyClass border">@inven.Qty</span></td>
                                        <td>@inven.Condition</td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm" role="group">
                                                <a asp-action="Edit" asp-route-id="@inven.Id" class="btn btn-outline-warning btn-sm" title="Edit Barang">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@inven.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('Yakin mau hapus barang @inven.ItemName?')"
                                                            title="Delete Barang">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
